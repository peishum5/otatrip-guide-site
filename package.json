{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check:images && astro build --force && node scripts/optimize-built-images.mjs",
    "check:images": "node scripts/check-images.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "ga4:analyze": "node scripts/ga4/analyze.mjs",
    "ga4:daily": "node scripts/ga4/analyze.mjs --granularity day --periods 14",
    "ga4:weekly": "node scripts/ga4/analyze.mjs --granularity week --periods 8",
    "ga4:monthly": "node scripts/ga4/analyze.mjs --granularity month --periods 6",
    "ga4:overview": "node scripts/ga4/analyze.mjs --granularity day,week,month",
    "ga4:report": "node scripts/ga4/weekly-report.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/vercel": "^11.0.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "^6.3.0"
    }
  }
}
