GA4_PROPERTY_ID=123456789
GA4_SERVICE_ACCOUNT_KEY_PATH=./secrets/ga4-service-account.json

# Google Apps Script web app that receives /guest/guide-feedback submissions.
# Public by design (it ships in the browser bundle) — the script validates
# everything server-side. Get the value from: GAS editor > Deploy > Web app URL.
PUBLIC_FEEDBACK_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
