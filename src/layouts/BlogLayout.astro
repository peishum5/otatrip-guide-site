---
import BaseLayout from './BaseLayout.astro';
import ArticleCTA from '../components/ArticleCTA.astro';

interface FAQ {
  q: string;
  a: string;
}

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  hero_image?: string;
}

interface Props {
  title: string;
  description?: string;
  pubDate?: string;
  last_updated?: string;
  author?: string;
  canonical?: string;
  hero_image?: string;
  category?: string;
  categoryHref?: string;
  keywords?: string[];
  faq?: FAQ[];
  relatedPosts?: RelatedPost[];
  noIndex?: boolean;
}

const {
  title,
  description,
  pubDate,
  last_updated,
  author = 'OTAtrip Guide',
  canonical,
  hero_image,
  category,
  categoryHref,
  keywords = [],
  faq = [],
  relatedPosts = [],
  noIndex,
} = Astro.props;
const displayDate = last_updated || pubDate;
const siteUrl = (Astro.site ?? new URL('https://otatrip.guide')).origin;
const canonicalPath = canonical || Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = hero_image ? new URL(hero_image, siteUrl).toString() : new URL('/images/og-default.jpg', siteUrl).toString();
const graph: Record<string, unknown>[] = [
  {
    "@type": "Article",
    "headline": title,
    "description": description,
    "author": {
      "@type": "Person",
      "name": author
    },
    "datePublished": pubDate || displayDate,
    "dateModified": displayDate || pubDate,
    "mainEntityOfPage": canonicalUrl,
    "image": [imageUrl],
    "publisher": {
      "@type": "Organization",
      "name": "OTAtrip Guide",
      "url": siteUrl
    }
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": `${siteUrl}/blog`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": title,
        "item": canonicalUrl
      }
    ]
  }
];

if (faq.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={hero_image}
  ogType="article"
  keywords={keywords}
  publishedTime={pubDate}
  modifiedTime={displayDate}
  noIndex={noIndex}
>
  <!-- Hero image (full width, before article) -->
  {hero_image && hero_image !== '' && (
    <div class="relative w-full overflow-hidden" style="height: clamp(200px, 40vw, 400px);">
      <img src={hero_image} alt={title} class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-nes-black via-transparent to-transparent" style="background: linear-gradient(to top, #0a0a0a 0%, rgba(10,10,10,0.3) 40%, transparent 100%);"></div>
    </div>
  )}

  <article class="max-w-4xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="font-pixel text-gray-700 mb-8 flex items-center gap-2 flex-wrap" style="font-size: 0.45rem; letter-spacing: 0.06em;" aria-label="Breadcrumb">
      <a href="/" class="hover:text-nes-amber transition-colors">HOME</a>
      <span class="text-gray-800">/</span>
      <a href="/blog" class="hover:text-nes-amber transition-colors">GUIDES</a>
      {category && (
        <>
          <span class="text-gray-800">/</span>
          {categoryHref ? (
            <a href={categoryHref} class="hover:text-nes-amber transition-colors">{category.toUpperCase()}</a>
          ) : (
            <span class="text-gray-700">{category.toUpperCase()}</span>
          )}
        </>
      )}
    </nav>

    <!-- Title + meta -->
    <header class="mb-10 pb-8 border-b border-gray-800/60">
      <p class="font-pixel text-nes-cyan mb-4" style="font-size: 0.5rem; letter-spacing: 0.1em;">{(category || 'Kyoto Guide').toUpperCase()}</p>
      <h1 class="font-pixel text-nes-white leading-relaxed mb-6" style="font-size: clamp(0.75rem, 2.5vw, 1rem);">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-gray-600 font-pixel" style="font-size: 0.45rem; letter-spacing: 0.06em;">
        <span>BY {author.toUpperCase()}</span>
        {displayDate && displayDate !== '' && (
          <span class="text-gray-700">·</span>
        )}
        {displayDate && displayDate !== '' && (
          <time datetime={displayDate}>UPDATED {displayDate}</time>
        )}
      </div>
    </header>

    <!-- Content — prose for readability -->
    <div class="prose prose-lg max-w-none font-sans">
      <slot />
    </div>

    <!-- CTA -->
    <ArticleCTA />

    {faq.length > 0 && (
      <section class="mt-12 border-t border-gray-800/60 pt-10">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="font-pixel text-nes-amber" style="font-size: 0.6rem;">FAQ</h2>
          <div class="flex-1 pixel-divider"></div>
        </div>
        <div class="space-y-2">
          {faq.map((item) => (
            <details class="border border-gray-800 blog-card group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-pixel text-nes-white hover:text-nes-amber transition-colors" style="font-size: 0.55rem; line-height: 1.6;">
                {item.q}
                <span class="ml-4 text-gray-700 shrink-0 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="px-5 pb-5 pt-3 font-sans text-sm text-gray-400 leading-relaxed border-t border-gray-800">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="mt-12 border-t border-gray-800/60 pt-10">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="font-pixel text-nes-cyan" style="font-size: 0.6rem;">RELATED GUIDES</h2>
          <div class="flex-1 pixel-divider"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          {relatedPosts.map((item) => (
            <article class="blog-card group">
              <a href={`/blog/${item.slug}`} class="block h-full">
                {item.hero_image ? (
                  <div class="relative overflow-hidden" style="height: 120px;">
                    <img src={item.hero_image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                  </div>
                ) : (
                  <div class="bg-gray-900" style="height: 80px;"></div>
                )}
                <div class="p-4">
                  <h3 class="font-pixel text-nes-white group-hover:text-nes-amber transition-colors leading-relaxed mb-2" style="font-size: 0.5rem;">{item.title}</h3>
                  <p class="font-sans text-xs text-gray-600 leading-relaxed line-clamp-2">{item.description}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Author box -->
    <div class="mt-12 border-t border-gray-800/60 pt-8 flex items-start gap-4">
      <div class="w-11 h-11 border border-nes-amber bg-nes-black flex items-center justify-center shrink-0" style="box-shadow: 0 0 12px rgba(255,176,0,0.2);">
        <span class="font-pixel text-nes-amber" style="font-size: 0.5rem;">OG</span>
      </div>
      <div>
        <div class="font-pixel text-nes-white mb-2" style="font-size: 0.55rem;">{author.toUpperCase()}</div>
        <p class="font-sans text-sm text-gray-500 leading-relaxed">
          Local guide based in Gion, Kyoto. Leading intimate walking tours and sake experiences since 2018.
          Passionate about connecting travelers with authentic Kyoto culture.
        </p>
      </div>
    </div>

  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": graph
  })} />
</BaseLayout>
