---
import BaseLayout from './BaseLayout.astro';
import ArticleCTA from '../components/ArticleCTA.astro';

interface FAQ {
  q: string;
  a: string;
}

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  hero_image?: string;
}

interface Props {
  title: string;
  description?: string;
  pubDate?: string;
  last_updated?: string;
  author?: string;
  canonical?: string;
  hero_image?: string;
  category?: string;
  categoryHref?: string;
  keywords?: string[];
  faq?: FAQ[];
  relatedPosts?: RelatedPost[];
  noIndex?: boolean;
}

const {
  title,
  description,
  pubDate,
  last_updated,
  author = 'OTAtrip Guide',
  canonical,
  hero_image,
  category,
  categoryHref,
  keywords = [],
  faq = [],
  relatedPosts = [],
  noIndex,
} = Astro.props;
const displayDate = last_updated || pubDate;
const siteUrl = (Astro.site ?? new URL('https://otatrip.guide')).origin;
const canonicalPath = canonical || Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = hero_image ? new URL(hero_image, siteUrl).toString() : new URL('/images/og-default.jpg', siteUrl).toString();
const graph: Record<string, unknown>[] = [
  {
    "@type": "Article",
    "headline": title,
    "description": description,
    "author": {
      "@type": "Person",
      "name": author
    },
    "datePublished": pubDate || displayDate,
    "dateModified": displayDate || pubDate,
    "mainEntityOfPage": canonicalUrl,
    "image": [imageUrl],
    "publisher": {
      "@type": "Organization",
      "name": "OTAtrip Guide",
      "url": siteUrl
    }
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": `${siteUrl}/blog`
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": title,
        "item": canonicalUrl
      }
    ]
  }
];

if (faq.length > 0) {
  graph.push({
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={hero_image}
  ogType="article"
  keywords={keywords}
  publishedTime={pubDate}
  modifiedTime={displayDate}
  noIndex={noIndex}
>
  <!-- Hero image (full width, before article) -->
  {hero_image && hero_image !== '' && (
    <div class="relative w-full overflow-hidden" style="height: clamp(200px, 40vw, 400px);">
      <img src={hero_image} alt={title} class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0" style="background: linear-gradient(to top, #f5efdf 0%, rgba(245,239,223,0.25) 30%, transparent 60%);"></div>
    </div>
  )}

  <article class="max-w-4xl mx-auto px-4 py-10">

    <!-- Breadcrumb -->
    <nav class="font-display text-xs tracking-wide text-sumi-soft mb-8 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-shu transition-colors">Home</a>
      <span class="text-washi-edge">/</span>
      <a href="/blog" class="hover:text-shu transition-colors">Guides</a>
      {category && (
        <>
          <span class="text-washi-edge">/</span>
          {categoryHref ? (
            <a href={categoryHref} class="hover:text-shu transition-colors">{category}</a>
          ) : (
            <span>{category}</span>
          )}
        </>
      )}
    </nav>

    <!-- Title + meta -->
    <header class="mb-10 pb-8 border-b border-washi-edge">
      <p class="font-display text-sm tracking-[0.15em] text-ai mb-4">{category || 'Kyoto Guide'}</p>
      <h1 class="font-display font-bold text-sumi text-3xl md:text-4xl leading-snug mb-6">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sumi-soft font-sans text-xs tracking-wide">
        <span>By {author}</span>
        {displayDate && displayDate !== '' && (
          <span class="text-washi-edge">·</span>
        )}
        {displayDate && displayDate !== '' && (
          <time datetime={displayDate}>Updated {displayDate}</time>
        )}
      </div>
    </header>

    <!-- Content — prose for readability -->
    <div class="prose prose-lg max-w-none font-sans">
      <slot />
    </div>

    <!-- CTA -->
    <ArticleCTA />

    {faq.length > 0 && (
      <section class="mt-12 border-t border-washi-edge pt-10">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="font-display font-bold text-sumi text-lg">FAQ</h2>
          <div class="flex-1 pixel-divider"></div>
        </div>
        <div class="space-y-2">
          {faq.map((item) => (
            <details class="blog-card group">
              <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-display text-sm leading-relaxed text-sumi hover:text-shu transition-colors">
                {item.q}
                <span class="ml-4 text-sumi-soft shrink-0 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="px-5 pb-5 pt-3 font-sans text-sm text-sumi-soft leading-relaxed border-t border-washi-edge">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    {relatedPosts.length > 0 && (
      <section class="mt-12 border-t border-washi-edge pt-10">
        <div class="flex items-center gap-4 mb-6">
          <h2 class="font-display font-bold text-sumi text-lg">Related Guides</h2>
          <div class="flex-1 pixel-divider"></div>
        </div>
        <div class="grid md:grid-cols-3 gap-4">
          {relatedPosts.map((item) => (
            <article class="blog-card group">
              <a href={`/blog/${item.slug}`} class="block h-full">
                {item.hero_image ? (
                  <div class="relative overflow-hidden" style="height: 120px;">
                    <img src={item.hero_image} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                  </div>
                ) : (
                  <div class="bg-washi-deep" style="height: 80px;"></div>
                )}
                <div class="p-4">
                  <h3 class="font-display text-sm font-semibold text-sumi group-hover:text-shu transition-colors leading-relaxed mb-2">{item.title}</h3>
                  <p class="font-sans text-xs text-sumi-soft leading-relaxed line-clamp-2">{item.description}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Author box -->
    <div class="mt-12 border-t border-washi-edge pt-8 flex items-start gap-4">
      <span class="hanko text-2xl shrink-0" aria-hidden="true">京</span>
      <div>
        <div class="font-display font-semibold text-sumi text-sm mb-2">{author}</div>
        <p class="font-sans text-sm text-sumi-soft leading-relaxed">
          Local guide based in Gion, Kyoto. Leading intimate walking tours and sake experiences since 2018.
          Passionate about connecting travelers with authentic Kyoto culture.
        </p>
      </div>
    </div>

  </article>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": graph
  })} />
</BaseLayout>
