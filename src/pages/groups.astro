---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../config/site';
---

<BaseLayout
  title="Group Tours Kyoto — OTAtrip Guide"
  description="Private group walking tours in Gion, Higashiyama, and Kiyomizu. Flexible arrangements for any group size. Just get in touch."
  canonical="/groups"
>
  <!-- Header -->
  <section class="scanlines bg-washi border-b border-washi-edge py-16 text-center">
    <div class="relative z-10 max-w-3xl mx-auto px-4">
      <p class="font-display text-sm text-ai tracking-widest mb-4 rpg-prefix">For Groups</p>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-sumi mb-4">Group Tours</h1>
      <p class="font-sans text-sumi-soft text-sm max-w-xl mx-auto">
        Bringing a group to Kyoto? We're happy to figure something out together.
      </p>
    </div>
  </section>

  <div class="max-w-3xl mx-auto px-4 py-12">

    <!-- What we do -->
    <section class="mb-12">
      <div class="dialogue-box">
        <p class="font-display text-sm text-ai tracking-widest mb-4">About</p>
        <p class="font-sans text-sumi-soft text-sm leading-relaxed mb-4">
          We're not a travel agency — we're local guides who love showing people around Kyoto.
          Our home turf is the <span class="text-shu font-medium">Gion, Higashiyama, and Kiyomizu</span> area,
          and we can put together a walking experience that fits your group.
        </p>
        <p class="font-sans text-sumi-soft text-sm leading-relaxed">
          Group size, timing, pace, theme — just tell us what you're after and we'll see what we can do.
          No pressure. First message is always free.
        </p>
      </div>
    </section>

    <!-- What's flexible -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-xl md:text-2xl font-bold text-sumi">What We Can Work With</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {[
          { icon: '🗺️', title: 'Area', desc: 'Gion, Higashiyama, Kiyomizu-dera — the heart of old Kyoto.' },
          { icon: '👥', title: 'Group Size', desc: 'Small groups to larger parties. We split big groups to keep it intimate.' },
          { icon: '🕐', title: 'Timing', desc: 'Morning, afternoon, or night walks. We work around your schedule.' },
          { icon: '🌐', title: 'Language', desc: 'English tours as standard. Japanese support available.' },
        ].map(item => (
          <div class="dialogue-box flex gap-4 items-start">
            <span class="text-2xl shrink-0">{item.icon}</span>
            <div>
              <p class="font-display text-base font-semibold text-sumi mb-1">{item.title}</p>
              <p class="font-sans text-xs text-sumi-soft leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- How it works -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-xl md:text-2xl font-bold text-sumi">How It Works</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <div class="space-y-4">
        {[
          { step: '01', text: 'Drop us a message with your group size, dates, and what kind of experience you\'re after.' },
          { step: '02', text: 'We\'ll get back to you within 24 hours with ideas and a quote.' },
          { step: '03', text: 'We lock in the plan together. No complicated contracts.' },
        ].map(item => (
          <div class="flex gap-5 items-start">
            <div class="font-display text-sm font-bold text-shu shrink-0 w-8 text-right">{item.step}</div>
            <div class="flex-1 border-t border-washi-edge pt-3">
              <p class="font-sans text-sm text-sumi-soft leading-relaxed">{item.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Email CTA -->
    <section id="contact-form" class="mb-12">
      <div class="dialogue-box">
        <p class="font-display text-sm text-ai tracking-widest mb-4">Send Us an Email</p>
        <p class="font-sans text-sm text-sumi-soft leading-relaxed mb-6">
          Drop us an email with your <span class="text-shu">group size</span>,
          <span class="text-shu">preferred dates</span>, and
          <span class="text-shu">what kind of experience</span> you have in mind.
          We'll get back to you within 24 hours.
        </p>
        <a
          href={`mailto:${CONTACT_EMAIL}?subject=Group%20Tour%20Inquiry`}
          class="nes-btn nes-btn-gold w-full text-center block"
        >
          Email Us Now
        </a>
        <p class="font-sans text-xs text-sumi-soft text-center mt-4">{CONTACT_EMAIL}</p>
      </div>
    </section>

    <!-- Back link -->
    <div class="text-center">
      <a href="/" class="font-display text-sm text-ai hover:text-shu transition-colors">
        &larr; Back to Tours
      </a>
    </div>

  </div>
</BaseLayout>
