---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../../config/site';

const flowSteps = [
  {
    number: '01',
    title: 'Go to Hankyu Kyoto-Kawaramachi Station Exit 1B',
    body: 'Exit 1B is the closest exit. Come up to street level there, and you should immediately see the McDonald\'s sign next to the station entrance.',
  },
  {
    number: '02',
    title: 'Wait beside the wall outside',
    body: 'Stand on the sidewalk between the station entrance and McDonald\'s, beside the dark wall shown in the photo below.',
  },
  {
    number: '03',
    title: 'Look for the guide sign',
    body: 'Your guide will be holding a sign that says "OTAtrip Guide". Please arrive 5 to 10 minutes before the start time.',
  },
];

const missedSteps = [
  'Go back to the exact spot in the photo and wait there.',
  'Check both the station entrance side and the McDonald\'s side for the guide sign.',
  'Please wait a few minutes first. Sometimes the guide may arrive slightly late if the previous tour runs over.',
  'Send us a message in your booking app immediately.',
  'If messaging is difficult, email us right away using the address below.',
  'If 20 minutes have passed and you still have not met the guide, there may be a serious issue or the group may already have departed, and it may no longer be possible to join the tour that day.',
];
---

<BaseLayout
  title="Meeting Point: Kyoto Gion Night Walk"
  description="Exact meeting point and backup contact steps for the Kyoto Gion Night Walk."
  canonical="/guest/gion-night-walk-meeting-point"
  noIndex={true}
>
  <section class="border-b border-washi-edge bg-washi-deep">
    <div class="mx-auto max-w-3xl px-4 py-14 md:py-18">
      <p class="mb-3 font-display text-sm tracking-[0.15em] text-ai">Guest Info</p>
      <h1 class="mb-4 font-display text-3xl font-bold leading-tight text-sumi md:text-4xl">
        Meeting Point
      </h1>
      <p class="font-sans text-base leading-relaxed text-sumi-soft">
        Please follow the instructions from top to bottom. If you use the photo first, the meeting point should be easy to recognize.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-10 md:py-12">
    <section class="mb-10 dialogue-box">
      <p class="mb-2 font-display text-sm tracking-[0.15em] text-shu">Meet Here</p>
      <p class="font-sans text-base font-semibold leading-relaxed text-sumi">
        Outside Hankyu Kyoto-Kawaramachi Station Exit 1B, beside McDonald&apos;s
      </p>
      <p class="mt-3 font-sans text-sm leading-relaxed text-sumi-soft">
        Do not wait inside McDonald&apos;s or inside the station gate. Please wait outside on the sidewalk.
      </p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a
          href="https://maps.app.goo.gl/J7SmSwzVmAfjZJs36"
          target="_blank"
          rel="noopener noreferrer"
          class="nes-btn nes-btn-gold text-center"
        >
          Open Google Maps
        </a>
        <a
          href={`mailto:${CONTACT_EMAIL}?subject=Cannot%20find%20the%20meeting%20point`}
          class="nes-btn nes-btn-outline text-center"
        >
          Email Us
        </a>
      </div>
    </section>

    <section class="mb-12">
      <p class="mb-4 font-display text-sm tracking-[0.15em] text-shu">Photo Reference</p>
      <img
        src="/images/meeting-points/gion-night-walk-photo.jpg"
        alt="Night view outside Hankyu Kyoto-Kawaramachi Station next to McDonald's, with a red circle marking the sidewalk waiting spot beside the wall."
        class="w-full border border-washi-edge bg-washi-deep"
        loading="eager"
      />
      <div class="border-x border-b border-washi-edge bg-washi-deep px-5 py-4">
        <p class="font-sans text-sm leading-relaxed text-sumi">
          The red circle marks the correct waiting spot.
        </p>
        <p class="mt-2 font-sans text-sm leading-relaxed text-sumi-soft">
          Landmark order: station exit, McDonald&apos;s sign, dark wall, sidewalk waiting area.
        </p>
      </div>
    </section>

    <section class="mb-12">
      <p class="mb-5 font-display text-sm tracking-[0.15em] text-shu">Follow This Order</p>
      <div class="space-y-4">
        {flowSteps.map((step) => (
          <div class="washi-card px-5 py-5">
            <div class="mb-3 flex items-center gap-3">
              <span class="font-display text-sm font-bold text-matsu">{step.number}</span>
              <h2 class="font-display text-lg font-semibold leading-tight text-sumi">{step.title}</h2>
            </div>
            <p class="font-sans text-sm leading-relaxed text-sumi-soft">{step.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-12 dialogue-box">
      <p class="mb-4 font-display text-sm font-semibold tracking-[0.15em] text-shu">If You Can&apos;t Find Us</p>
      <div class="space-y-3">
        {missedSteps.map((step, index) => (
          <div class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 font-display text-sm font-bold text-shu">{index + 1}</span>
            <p class="font-sans text-sm leading-relaxed text-sumi-soft">{step}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 border-t border-washi-edge pt-5">
        <p class="font-sans text-sm leading-relaxed text-sumi-soft">
          Fastest backup contact: message us in your booking platform. If that is not possible, use the email below.
        </p>
        <a
          href={`mailto:${CONTACT_EMAIL}?subject=Cannot%20find%20the%20meeting%20point`}
          class="mt-4 block border border-shu px-4 py-4 font-display text-sm text-shu transition-colors hover:bg-shu hover:text-washi"
        >
          {CONTACT_EMAIL}
        </a>
        <p class="mt-4 font-sans text-sm leading-relaxed text-sumi-soft">
          <strong class="text-sumi">We are a small team.</strong> <strong class="text-shu-dark">If the guide is already leading the tour, we may not be able to respond immediately</strong> by email or phone while guiding guests.
        </p>
        <p class="mt-3 font-sans text-sm leading-relaxed text-sumi-soft">
          <strong class="text-sumi">If the problem was caused by us,</strong> we will offer either a <strong class="text-shu-dark">free change to another tour/date</strong> or a <strong class="text-shu-dark">full refund</strong>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
