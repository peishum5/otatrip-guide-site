---
import BaseLayout from '../layouts/BaseLayout.astro';

const guides = [
  {
    id: 'shumpei',
    name: 'SHUMPEI',
    realName: '名越俊平',
    class: 'KYOTO MAGE',
    role: 'Founder · Magician & Astrophysicist',
    level: 13,
    portrait: '🪄',
    photo: '/images/guides/shumpei.jpg',
    xId: 'peishum5',
    bio: 'Founder of OTAtrip Guide. Holds a Ph.D. in astrophysics and built a parallel career as a professional magician, designing immersive experiences and Alternate Reality Games (ARGs). A tech enthusiast and performer who has called Kyoto home for 13 years.',
    stats: [
      { label: 'KYOTO KNOWLEDGE', value: 90, note: '13 YRS' },
      { label: 'ENTERTAINMENT', value: 98, note: 'MAGICIAN' },
      { label: 'TECH & SCIENCE', value: 96, note: 'Ph.D.' },
      { label: 'LANGUAGES', value: 85, note: 'EN/JP' },
    ],
  },
];
---

<BaseLayout
  title="Our Guides | OTAtrip Guide"
  description="Meet the local experts who lead your Kyoto experience. A magician-astrophysicist founder and a growing team of local guides — all based in Kyoto."
  canonical="/guide"
>
  <!-- PLAYER SELECT Header -->
  <section class="scanlines bg-nes-black py-16 text-center">
    <div class="relative z-10 max-w-3xl mx-auto px-4">
      <p class="font-sans text-sm text-nes-amber/60 tracking-[0.6em] mb-4" aria-hidden="true">★★★★★★★★★★★</p>
      <p class="font-pixel text-[0.9rem] text-nes-amber mb-6 rpg-prefix">SELECT YOUR GUIDE</p>
      <h1 class="font-pixel text-nes-white mb-6" style="font-size: clamp(1.2rem, 5vw, 2.5rem);">PLAYER SELECT</h1>
      <p class="font-pixel text-[0.9rem] text-nes-cyan pixel-cursor">CHOOSE YOUR GUIDE</p>
      <p class="font-sans text-sm text-nes-amber/60 tracking-[0.6em] mt-6" aria-hidden="true">★★★★★★★★★★★</p>
    </div>
  </section>

  <!-- Guide Cards -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="max-w-md mx-auto">

      <!-- Real guide cards -->
      {guides.map((guide, i) => (
        <div class="dialogue-box flex flex-col">
          <!-- Portrait + Identity -->
          <div class="text-center mb-6 border-b border-gray-800 pb-6">
            {guide.photo ? (
              <img
                src={guide.photo}
                alt={guide.name}
                class="w-20 h-20 md:w-24 md:h-24 mx-auto object-cover border-2 border-nes-amber mb-4"
              />
            ) : (
              <div class="w-20 h-20 md:w-24 md:h-24 mx-auto bg-neutral-900 border-2 border-nes-amber flex items-center justify-center text-5xl mb-4">
                {guide.portrait}
              </div>
            )}
            <p class="px-label text-nes-cyan mb-2">PLAYER {i + 1}</p>
            <h2 class="font-pixel text-[0.85rem] text-nes-white mb-1 leading-relaxed">{guide.name}</h2>
            {guide.realName && (
              <p class="font-sans text-xs text-gray-400 mb-3">{guide.realName}</p>
            )}
            <div class="inline-block border border-nes-cyan px-3 py-1 mb-3">
              <span class="px-label text-nes-cyan">{guide.class}</span>
            </div>
            <p class="font-dot text-sm text-gray-200 mb-2">{guide.role}</p>
            <p class="px-label text-nes-green">LV. {guide.level}</p>
            <p class="font-sans text-xs text-gray-400 mt-1">{guide.level} years in Kyoto</p>
            {guide.xId && (
              <a
                href={`https://x.com/${guide.xId}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 mt-3 font-sans text-xs text-gray-400 hover:text-nes-cyan transition-colors"
              >
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                @{guide.xId}
              </a>
            )}
          </div>

          <!-- Stats -->
          <div class="mb-6 border-b border-gray-800 pb-6">
            <p class="font-pixel text-[0.9rem] text-nes-cyan mb-4">// STATS</p>
            <div class="space-y-4">
              {guide.stats.map(stat => (
                <div>
                  <div class="flex justify-between mb-1">
                    <span class="font-sans text-xs text-gray-400">{stat.label}</span>
                    {stat.note && (
                      <span class="font-sans text-xs text-nes-amber font-medium">{stat.note}</span>
                    )}
                  </div>
                  <div class="stat-bar-track">
                    <div class="stat-bar-fill" style={`width: ${stat.value}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Bio -->
          <div class="mb-6 flex-1">
            <p class="font-pixel text-[0.9rem] text-nes-cyan mb-4">// BIO</p>
            <p class="font-sans text-sm text-gray-300 leading-relaxed">{guide.bio}</p>
          </div>

          <!-- CTA -->
          <a href="/tours" class="nes-btn nes-btn-gold block w-full text-center">
            START ADVENTURE
          </a>
        </div>
      ))}

    </div>

    <!-- PLAYER 2: guide recruitment -->
    <div class="max-w-md mx-auto mt-8 border-2 border-dashed border-gray-700 p-5 flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="flex-1">
        <p class="px-label text-nes-cyan mb-2">PLAYER 2 · JOIN THE PARTY</p>
        <p class="font-sans text-sm text-gray-300 leading-relaxed">Love Kyoto and talking with travelers? We're looking for new guides.</p>
      </div>
      <a href="/contact" class="nes-btn nes-btn-outline text-center shrink-0">GET IN TOUCH</a>
    </div>
  </section>

  <!-- Back link -->
  <div class="text-center pb-16 border-t border-gray-900 pt-8">
    <a href="/" class="font-pixel text-[0.9rem] text-nes-amber hover:text-nes-cyan transition-colors">
      &lt; BACK TO QUEST SELECT
    </a>
  </div>
</BaseLayout>
