---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreRadial from '../components/ExploreRadial.astro';
import GionQuest from '../components/GionQuest.astro';
import GroupCTA from '../components/GroupCTA.astro';
import ParallaxBand from '../components/ParallaxBand.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const latestPosts = blogPosts.slice(0, 3);
---

<BaseLayout
  title="OTAtrip Guide — Kyoto Local Tours & Travel Guides"
  description="Explore Kyoto with local expert guides. Rated 4.9/5 on TripAdvisor. Book a walking tour or browse our practical travel guides for first-time visitors."
>
  <!-- Hero Section -->
  <section class="relative bg-washi overflow-hidden">
    <img
      src="/images/theme/hero-ukiyoe.webp"
      alt="Ukiyo-e style woodblock print of Gion, Kyoto at night"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <!-- Washi scrim for text legibility -->
    <div class="absolute inset-0 bg-gradient-to-r from-washi via-washi/85 to-transparent md:to-washi/10"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-4 py-20 md:py-32">
      <!-- Vertical decorative kanji -->
      <span class="vertical-jp hidden lg:block absolute right-8 top-1/2 -translate-y-1/2 text-kin text-3xl opacity-60 select-none" aria-hidden="true">京都　祇園</span>

      <!-- Rating badge -->
      <div class="hero-reveal inline-flex items-center gap-3 washi-card border-2 border-sumi px-4 py-2 mb-8" style="--d:0.05s; box-shadow: 3px 3px 0 rgba(33,29,25,0.15);">
        <span class="hanko text-sm" aria-hidden="true">評</span>
        <span class="text-kin text-sm">★★★★★</span>
        <span class="font-display font-bold text-sumi">4.9 / 5</span>
        <span class="font-sans text-xs text-sumi-soft">on TripAdvisor</span>
      </div>

      <!-- Heading -->
      <h1 class="hero-reveal font-display font-bold text-sumi leading-tight mb-6" style="--d:0.15s; font-size: clamp(2.1rem, 5vw, 3.5rem);">
        Discover <span class="text-shu">Kyoto</span>,<br />
        like a local.
      </h1>

      <!-- Description -->
      <p class="hero-reveal font-sans text-sumi-soft text-lg leading-relaxed mb-9 max-w-xl" style="--d:0.25s">
        Intimate walking tours through Gion's lantern-lit alleys. Sake tastings at bars only locals know.
        Small groups, genuine experiences.
      </p>

      <!-- Buttons -->
      <div class="hero-reveal flex flex-col sm:flex-row gap-5" style="--d:0.35s">
        <a href="/tours" class="nes-btn nes-btn-gold" data-track-label="home_hero_see_tours">See All Tours</a>
        <a href="/blog" class="nes-btn nes-btn-outline" data-track-label="home_hero_browse_guides">Browse Travel Guides</a>
      </div>
    </div>
  </section>

  <!-- Explore hub (radial) -->
  <ExploreRadial />

  <!-- Why Choose Us -->
  <section class="bg-washi py-16 seigaiha-bg">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <p class="font-display text-sm text-ai mb-4 tracking-widest">Why OTAtrip Guide</p>
        <h2 class="font-display font-bold text-sumi text-2xl md:text-3xl">
          Kyoto, from the Inside
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {[
          {
            icon: '🏮',
            img: '/images/why/local-expertise.jpg',
            title: 'Local Expertise',
            desc: "Our guides have lived in Kyoto for years. We take you to bars, alleys, and viewpoints most visitors never find.",
          },
          {
            icon: '🎭',
            img: '/images/why/entertainment-pro.png',
            title: 'Entertainment Pros',
            desc: 'OTAtrip Guide was started by a professional magician. We design our tours like shows — with pacing, surprises, and moments you will keep telling people about.',
          },
          {
            icon: '👥',
            img: '/images/why/small-groups.jpg',
            title: 'Small Groups',
            desc: 'We keep groups small so every guest gets real attention. Ask questions, go off-script, connect with your guide and the city on your own terms.',
          },
        ].map(item => (
          <div class="blog-card group">
            <div class="relative overflow-hidden" style="height: 220px;">
              {item.img ? (
                <img src={item.img} alt={item.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-400" />
              ) : (
                <div class="w-full h-full bg-washi-deep flex items-center justify-center">
                  <span class="text-5xl">{item.icon}</span>
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
            </div>
            <div class="p-6">
              <h3 class="font-display font-bold text-lg text-sumi mb-3">{item.title}</h3>
              <p class="font-sans text-sumi-soft text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mini Game -->
  <section class="max-w-4xl mx-auto px-4 py-10">
    <div class="flex items-center gap-4 mb-2">
      <h2 class="font-display font-bold text-lg text-sumi">Mini Game — Gion Night Quest</h2>
      <div class="flex-1 border-t border-washi-edge"></div>
      <a href="/game" class="font-display text-xs text-ai hover:text-shu transition-colors tracking-wide">
        Full page &rsaquo;
      </a>
    </div>
    <p class="font-sans text-sm text-sumi-soft mb-6">
      An 8-bit interlude: explore a tiny pixel-art Gion at night. Talk to the locals, collect 3 stamps — then book the real thing.
    </p>
    <GionQuest />
  </section>

  <!-- Reviews, over the fixed night-Gion backdrop -->
  <ParallaxBand>
    <div class="max-w-6xl mx-auto px-4">
      <ReviewsSection onDark />
    </div>
  </ParallaxBand>

  <!-- Tours teaser -->
  <section class="max-w-6xl mx-auto px-4 pb-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="font-display text-sm text-ai mb-2 tracking-widest">Tours &amp; Experiences</p>
        <h2 class="font-display font-bold text-sumi text-2xl md:text-3xl">
          Our Tours
        </h2>
      </div>
      <a href="/tours" class="font-display text-xs text-ai hover:text-shu transition-colors hidden md:block tracking-wide">
        All tours &rsaquo;
      </a>
    </div>
    <div class="space-y-3">
      {[
        {
          icon: '🏮',
          tag: 'Evening · Gion',
          name: 'Gion Sake Walking Tour',
          meta: '3 hrs · Max 10 · Sake · EN',
          price: 'from ¥5,600',
          href: '/tours/gion-sake-walk',
        },
        {
          icon: '🍻',
          tag: 'Evening · Pontocho',
          name: 'Kyoto Izakaya Hopping',
          meta: '3 hrs · Small group · Food · EN',
          price: 'from ¥4,160',
          href: '/tours/izakaya-hopping',
        },
        {
          icon: '⛩️',
          tag: 'Morning · Shimogamo',
          name: 'Shimogamo Shrine & Manga Walk',
          meta: '2 hrs · 10:00 / 14:00 · Manga · EN',
          price: 'from ¥8,500',
          href: '/tours/shimogamo-manga-walk',
        },
        {
          icon: '☕',
          tag: 'Daytime · Nishiki Market',
          name: 'Hands-On Coffee Ceremony with a Master',
          meta: '70 min · Max 4 · Coffee · EN',
          price: '¥24,000 / group',
          href: '/tours/coffee-ceremony',
        },
      ].map(tour => (
        <a href={tour.href} class="blog-card group flex flex-col sm:flex-row items-start sm:items-center gap-5 p-5 block">
          <div class="text-3xl shrink-0 group-hover:scale-110 transition-transform">{tour.icon}</div>
          <div class="flex-1 min-w-0">
            <p class="font-display text-xs text-ai mb-1 tracking-wide">{tour.tag}</p>
            <h3 class="font-display font-bold text-lg text-sumi group-hover:text-shu transition-colors leading-relaxed mb-1">{tour.name}</h3>
            <p class="font-sans text-xs text-sumi-soft">{tour.meta} · <span class="text-shu font-medium">{tour.price}</span></p>
          </div>
          <span class="font-display text-sm text-shu group-hover:text-shu-dark transition-colors shrink-0">
            View &rarr;
          </span>
        </a>
      ))}
    </div>
    <div class="text-center mt-6 md:hidden">
      <a href="/tours" class="font-display text-sm text-ai hover:text-shu transition-colors tracking-wide">All tours &rsaquo;</a>
    </div>
  </section>

  <!-- B2B Group CTA -->
  <section class="max-w-6xl mx-auto px-4">
    <GroupCTA />
  </section>

  <!-- Latest Blog Posts -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="font-display text-sm text-ai mb-2 tracking-widest">Travel Guides</p>
        <h2 class="font-display font-bold text-sumi text-2xl md:text-3xl">
          Plan Your Kyoto Trip
        </h2>
      </div>
      <a href="/blog" class="font-display text-xs text-ai hover:text-shu transition-colors hidden md:block tracking-wide">
        All guides &rsaquo;
      </a>
    </div>

    {latestPosts.length > 0 ? (
      <div class="grid md:grid-cols-3 gap-5">
        {latestPosts.map(post => (
          <article class="blog-card group">
            <a href={`/blog/${post.slug}`} class="block h-full">
              <div class="relative overflow-hidden" style="height: 180px;">
                {post.data.hero_image ? (
                  <img
                    src={post.data.hero_image}
                    alt={post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-400"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full bg-washi-deep flex items-center justify-center">
                    <span class="font-display text-sumi-soft">KYOTO</span>
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
                <span class="img-badge">{post.data.category || 'Kyoto Guide'}</span>
              </div>
              <div class="p-5">
                <h3 class="font-display font-bold text-sumi group-hover:text-shu transition-colors leading-relaxed mb-3 line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="font-sans text-sumi-soft text-sm leading-relaxed line-clamp-3">{post.data.description}</p>
                <div class="mt-4 font-display text-xs text-ai group-hover:text-shu transition-colors tracking-wide">
                  Read guide &rarr;
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="font-display text-sumi-soft text-center py-12">New guides coming soon</p>
    )}

    <div class="text-center mt-8 md:hidden">
      <a href="/blog" class="font-display text-sm text-ai hover:text-shu transition-colors tracking-wide">All guides &rsaquo;</a>
    </div>
  </section>

</BaseLayout>
