---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getBlogCategory, getBlogSortDate, getCategoryHref, normalizeBlogSlug } from '../../utils/blog';

const allPosts = await getCollection('blog');

const categoryOrder = [
  'Planning Basics',
  'Itineraries',
  'Sights',
  'Neighborhoods',
  'Food & Drink',
  'Culture',
  'Day Trips',
  'Seasonal',
  'More Guides',
];

const groupedPosts = allPosts
  .slice()
  .sort((a, b) => getBlogSortDate(b) - getBlogSortDate(a))
  .reduce<Record<string, typeof allPosts>>((acc, post) => {
    const category = getBlogCategory(post);
    if (!acc[category]) acc[category] = [];
    acc[category].push(post);
    return acc;
  }, {});

const orderedCategories = [
  ...categoryOrder.filter((c) => groupedPosts[c]?.length),
  ...Object.keys(groupedPosts).filter((c) => !categoryOrder.includes(c)).sort(),
];

const sortedAll = allPosts.slice().sort((a, b) => getBlogSortDate(b) - getBlogSortDate(a));
const featuredPost = sortedAll.find(p => p.data.hero_image) ?? sortedAll[0];
---

<BaseLayout
  title="Kyoto Travel Guides — OTAtrip Guide Blog"
  description="Practical travel guides for first-time visitors to Kyoto. Planning basics, itineraries, neighborhoods, food, and more — written by local experts."
>

  <!-- Header -->
  <section class="relative bg-nes-black overflow-hidden">
    <div class="dot-grid-bg absolute inset-0 opacity-60"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-nes-black pointer-events-none"></div>
    <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 text-center">
      <p class="kicker text-nes-cyan mb-4 rpg-prefix">LOCAL KNOWLEDGE</p>
      <h1 class="section-title mb-5">
        Kyoto travel guides
      </h1>
      <p class="font-sans text-gray-400 text-base max-w-xl mx-auto leading-relaxed mb-8">
        Practical, firsthand guides from local experts who know Kyoto's streets, seasons, and secrets.
      </p>
      <div class="flex items-center justify-center gap-8">
        <div class="text-center">
          <div class="font-pixel text-[0.9rem] text-nes-amber text-glow-amber">{allPosts.length}</div>
          <div class="kicker text-gray-400 mt-2">GUIDES</div>
        </div>
        <div class="w-px h-8 bg-gray-800"></div>
        <div class="text-center">
          <div class="font-pixel text-[0.9rem] text-nes-amber text-glow-amber">{orderedCategories.length}</div>
          <div class="kicker text-gray-400 mt-2">TOPICS</div>
        </div>
        <div class="w-px h-8 bg-gray-800"></div>
        <div class="text-center">
          <div class="font-pixel text-[0.9rem] text-nes-amber text-glow-amber">FREE</div>
          <div class="kicker text-gray-400 mt-2">ALWAYS</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="max-w-6xl mx-auto px-4 pt-10 pb-6">
      <div class="flex items-center gap-4 mb-5">
        <span class="kicker text-nes-amber rpg-prefix">FEATURED GUIDE</span>
        <div class="flex-1 pixel-divider"></div>
      </div>
      <a href={`/blog/${normalizeBlogSlug(featuredPost.slug)}`} class="group block relative overflow-hidden blog-card">
        <div class="relative h-64 md:h-96">
          {featuredPost.data.hero_image ? (
            <img
              src={featuredPost.data.hero_image}
              alt={featuredPost.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          ) : (
            <div class="w-full h-full bg-gray-900 flex items-center justify-center">
              <span class="kicker text-gray-400">NO IMAGE</span>
            </div>
          )}
          <div class="featured-gradient absolute inset-0"></div>
          <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-10">
            <span class="kicker text-nes-cyan mb-3">
              {getBlogCategory(featuredPost).toUpperCase()}
            </span>
            <h2 class="section-title group-hover:text-nes-amber transition-colors mb-3">
              {featuredPost.data.title}
            </h2>
            <p class="font-sans text-gray-300 text-sm leading-relaxed max-w-2xl mb-4 line-clamp-2">
              {featuredPost.data.description}
            </p>
            <div class="inline-flex items-center gap-2 font-sans text-xs uppercase tracking-wider text-nes-amber group-hover:text-nes-white transition-colors">
              READ GUIDE <span class="group-hover:translate-x-1 transition-transform inline-block">&rarr;</span>
            </div>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- Category Filter Bar -->
  <div class="sticky top-[56px] z-40 bg-nes-black border-b border-gray-800/60 shadow-[0_4px_20px_rgba(0,0,0,0.6)]">
    <div class="max-w-6xl mx-auto px-4">
      <div id="cat-filters" class="scroll-x-smooth flex gap-2 py-3 min-w-0">
        <button class="cat-pill active shrink-0" data-cat="all">ALL GUIDES</button>
        {orderedCategories.map(cat => (
          <button class="cat-pill shrink-0" data-cat={cat}>{cat.toUpperCase()}</button>
        ))}
      </div>
    </div>
  </div>

  <!-- Post Sections -->
  <div class="max-w-6xl mx-auto px-4 py-10 space-y-14" id="blog-content">
    {orderedCategories.map((category) => groupedPosts[category]?.length > 0 && (
      <section class="blog-section" data-cat={category}>
        <!-- Category heading -->
        <div class="flex items-center gap-4 mb-6">
          <div class="shrink-0">
            <a href={getCategoryHref(category)} class="group flex items-center gap-3 hover:opacity-80 transition-opacity">
              <span class="kicker text-nes-amber leading-none">{category.toUpperCase()}</span>
            </a>
          </div>
          <div class="flex-1 pixel-divider"></div>
          <span class="font-sans text-xs uppercase tracking-wider text-gray-400 shrink-0">{groupedPosts[category].length} GUIDES</span>
        </div>

        <!-- Cards grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {groupedPosts[category].map(post => (
            <article class="blog-card group">
              <a href={`/blog/${normalizeBlogSlug(post.slug)}`} class="block h-full">
                <!-- Image -->
                <div class="relative overflow-hidden" style="height: 200px;">
                  {post.data.hero_image ? (
                    <img
                      src={post.data.hero_image}
                      alt={post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-400"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-gray-900 flex items-center justify-center">
                      <span class="kicker text-gray-400">KYOTO</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                  <span class="img-badge">{getBlogCategory(post).toUpperCase()}</span>
                </div>

                <!-- Body -->
                <div class="p-5">
                  <h3 class="card-title group-hover:text-nes-amber transition-colors mb-3 line-clamp-2">
                    {post.data.title}
                  </h3>
                  <p class="font-sans text-gray-400 text-sm leading-relaxed line-clamp-3 mb-5">
                    {post.data.description}
                  </p>
                  <div class="flex items-center justify-between">
                    <span class="font-sans text-xs text-gray-400">{post.data.author || 'OTAtrip Guide'}</span>
                    <span class="font-sans text-xs uppercase tracking-wider text-nes-cyan group-hover:text-nes-amber transition-colors">
                      READ &rarr;
                    </span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}

    {allPosts.length === 0 && (
      <p class="font-sans text-sm uppercase tracking-wider text-gray-400 text-center py-20">// TRAVEL GUIDES COMING SOON</p>
    )}
  </div>

  <!-- CTA Banner -->
  <section class="bg-nes-black border-y border-gray-800 py-12 mt-4">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <p class="kicker text-nes-cyan mb-3 rpg-prefix">READY TO EXPLORE?</p>
      <h2 class="section-title mb-5">
        Experience Kyoto in person
      </h2>
      <p class="font-sans text-gray-400 text-sm leading-relaxed mb-8 max-w-md mx-auto">
        Our local guides bring these stories to life. Small groups, hidden bars, and genuine Kyoto moments.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/tours" class="nes-btn nes-btn-gold">SEE ALL TOURS</a>
        <a href="/contact" class="nes-btn nes-btn-outline">ASK A QUESTION</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
  const sections = document.querySelectorAll<HTMLElement>('.blog-section');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const cat = pill.dataset.cat ?? 'all';

      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');

      if (cat === 'all') {
        sections.forEach(s => { s.style.display = ''; });
      } else {
        sections.forEach(s => {
          s.style.display = (s.dataset.cat === cat) ? '' : 'none';
        });
      }

      // Scroll to content area smoothly
      const content = document.getElementById('blog-content');
      if (content) {
        const y = content.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    });
  });
</script>
