---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getBlogCategory, getBlogSortDate, getCategoryHref, normalizeBlogSlug, slugifyCategory } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map((post) => getBlogCategory(post)))];

  return categories.map((category) => ({
    params: { category: slugifyCategory(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = (await getCollection('blog'))
  .filter((post) => !post.data.noIndex && getBlogCategory(post) === category)
  .sort((a, b) => getBlogSortDate(b) - getBlogSortDate(a));

const canonical = getCategoryHref(category);
const description = `${category} guides for Kyoto travelers. Practical local advice, curated recommendations, and trip-planning content from OTAtrip Guide.`;
const siteUrl = (Astro.site ?? new URL('https://otatrip.guide')).origin;
const canonicalUrl = new URL(canonical, siteUrl).toString();
---

<BaseLayout
  title={`${category} Guides in Kyoto`}
  description={description}
  canonical={canonical}
  ogImage={posts[0]?.data.hero_image}
>
  <section class="scanlines bg-washi-deep py-16 text-center">
    <div class="relative z-10 max-w-4xl mx-auto px-4">
      <p class="font-display text-sm tracking-[0.2em] text-ai mb-4">Blog Category</p>
      <h1 class="font-display font-bold text-sumi text-3xl md:text-4xl mb-4">{category}</h1>
      <p class="font-sans text-sumi-soft text-sm max-w-2xl mx-auto leading-relaxed">
        Local Kyoto guides grouped by topic so search engines and readers can follow the same content cluster.
      </p>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12">
    <nav class="font-display text-xs tracking-wide text-sumi-soft mb-8 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
      <a href="/" class="hover:text-shu transition-colors">Home</a>
      <span class="text-washi-edge">/</span>
      <a href="/blog" class="hover:text-shu transition-colors">Blog</a>
      <span class="text-washi-edge">/</span>
      <span>{category}</span>
    </nav>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <article class="blog-card group">
          {post.data.hero_image && (
            <a href={`/blog/${normalizeBlogSlug(post.slug)}`} class="block overflow-hidden border-b border-washi-edge">
              <div>
                <img
                  src={post.data.hero_image}
                  alt={post.data.title}
                  class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
            </a>
          )}
          <div class="p-4 md:p-5">
            <h2 class="font-display font-semibold text-base text-sumi group-hover:text-shu transition-colors leading-relaxed mb-3">
              <a href={`/blog/${normalizeBlogSlug(post.slug)}`} class="hover:text-shu transition-colors">
                {post.data.title}
              </a>
            </h2>
            <p class="font-sans text-sumi-soft text-sm leading-relaxed line-clamp-3 mb-4">{post.data.description}</p>
            <a
              href={`/blog/${normalizeBlogSlug(post.slug)}`}
              class="nes-btn nes-btn-outline inline-block text-sm"
            >
              Read Guide
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "CollectionPage",
        "name": `${category} Guides in Kyoto`,
        "url": canonicalUrl,
        "description": description
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": siteUrl
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": `${siteUrl}/blog`
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": category,
            "item": canonicalUrl
          }
        ]
      }
    ]
  })} />
</BaseLayout>
