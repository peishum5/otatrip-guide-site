---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL } from '../config/site';
---

<BaseLayout
  title="Contact | OTAtrip Guide"
  description="Get in touch with OTAtrip Guide for tour bookings, group inquiries, and Kyoto travel questions. We reply within 24 hours."
  canonical="/contact"
>
  <!-- Header -->
  <section class="scanlines bg-washi-deep py-16 text-center">
    <div class="relative z-10 max-w-2xl mx-auto px-4">
      <h1 class="font-display font-bold text-sumi text-3xl md:text-4xl mb-4">Contact Us</h1>
      <p class="font-sans text-sumi-soft text-sm">Questions about tours, groups, or anything Kyoto? We reply within 24 hours.</p>
    </div>
  </section>

  <div class="max-w-2xl mx-auto px-4 py-12">

    <!-- Quick links -->
    <div class="grid md:grid-cols-2 gap-4 mb-10">
      <a href="/groups" class="dialogue-box hover:border-shu transition-colors group block">
        <p class="font-display text-xs tracking-[0.15em] text-ai mb-2">Groups &amp; Agencies</p>
        <p class="font-display font-semibold text-base text-sumi group-hover:text-shu transition-colors mb-1">Send Group Inquiry &rarr;</p>
        <p class="font-sans text-xs text-sumi-soft mt-1">Custom tours, flexible groups</p>
      </a>
      <a href="/tours/gion-sake-walk#booking" class="dialogue-box hover:border-shu transition-colors group block">
        <p class="font-display text-xs tracking-[0.15em] text-ai mb-2">Individual Booking</p>
        <p class="font-display font-semibold text-base text-sumi group-hover:text-shu transition-colors mb-1">Book a Tour Directly &rarr;</p>
        <p class="font-sans text-xs text-sumi-soft mt-1">Reserve your spot on a tour</p>
      </a>
    </div>

    <!-- Email CTA -->
    <div class="dialogue-box">
      <h2 class="font-display font-bold text-lg text-sumi mb-4">General Inquiry</h2>
      <p class="font-sans text-sm text-sumi-soft leading-relaxed mb-6">
        Questions about tours, availability, or anything Kyoto-related? Send us an email and we'll get back to you within 24 hours.
      </p>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="nes-btn nes-btn-gold w-full text-center block"
      >
        Email Us Now
      </a>
      <p class="font-sans text-xs text-sumi-soft text-center mt-4">{CONTACT_EMAIL}</p>
    </div>

  </div>
</BaseLayout>
