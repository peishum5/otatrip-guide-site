---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tours = [
  {
    id: 'gion-sake-walk',
    name: 'Gion Sake Walking Tour',
    tagline: 'Lantern-lit alleys. Local sake bars. Old Kyoto.',
    description: 'An intimate evening walk through Gion\'s most atmospheric streets. Visit three hand-picked local sake bars, taste Fushimi-style sake, and hear the stories behind Kyoto\'s most iconic neighborhood.',
    duration: '90 minutes',
    groupSize: 'Max 10 guests',
    time: 'Evening',
    rating: '4.9',
    reviews: '100+',
    price: 'from ¥5,600',
    icon: '🏮',
    href: '/tours/gion-sake-walk',
    photo: '/images/tours/tour-gion-walk.jpg',
    tags: ['Evening', 'Sake', 'Walking', 'Gion'],
    highlights: [
      '3 sake tastings at curated local bars',
      'Walk Hanamikoji & Shinbashi',
      'Light snacks included',
    ],
  },
  {
    id: 'izakaya-hopping',
    name: 'Kyoto Izakaya Hopping',
    tagline: 'Pontocho & Gion backstreets. Real local izakayas.',
    description: 'Explore the vibrant backstreets of Kiyamachi and Pontocho with a local guide. Visit 2–3 izakayas that locals actually love — no tourist traps, no hidden commissions. Customizable for dietary preferences.',
    duration: '3 hours',
    groupSize: 'Small group',
    time: 'Evening',
    rating: null,
    reviews: null,
    price: 'from ¥4,160',
    icon: '🍻',
    href: '/tours/izakaya-hopping',
    photo: '/images/tours/izakaya/izakaya-guests.jpg',
    photoPosition: 'top',
    tags: ['Evening', 'Food', 'Walking', 'Pontocho'],
    highlights: [
      '2–3 local izakayas in Pontocho & Kiyamachi',
      'No hidden commissions — pay direct',
      'Customizable for dietary needs',
    ],
  },
  {
    id: 'shimogamo-manga-walk',
    name: 'Shimogamo Shrine & Manga Walk',
    tagline: 'World Heritage shrine. Cinematic photos. Custom manga souvenir.',
    description: 'A morning walk through ancient Shimogamo Shrine and Tadasu-no-Mori forest, finishing at the iconic Kamogawa Delta. We capture cinematic shots along the way — then turn them into a one-of-a-kind manga-style print just for you.',
    duration: 'Morning tour',
    groupSize: 'Small group',
    time: 'Morning',
    rating: null,
    reviews: null,
    price: 'from ¥8,500',
    icon: '⛩️',
    href: '/tours/shimogamo-manga-walk',
    photo: '/images/tours/shimogamo/photo-bridge.jpg',
    photoPosition: 'center 40%',
    tags: ['Morning', 'Walking', 'Shrine', 'Manga', 'Photo'],
    highlights: [
      'Shimogamo Shrine & Tadasu-no-Mori forest',
      'Original manga-style print souvenir',
      'High-res digital photos included',
    ],
  },
  {
    id: 'coffee-ceremony',
    name: 'Hands-On Coffee Ceremony with a Master',
    tagline: 'Hidden alley cafe. Japanese pour-over. Minutes from Nishiki Market.',
    description: 'Learn Japanese pour-over coffee at a hidden alley cafe a few minutes from Nishiki Market. Guided by a Master, you grind, bloom, and brew two different coffees, then compare them slowly over Kyoto sweets. Take home beans and your own recipe.',
    duration: '70 minutes',
    groupSize: 'Max 4 guests',
    time: 'Daytime',
    rating: null,
    reviews: null,
    price: '¥24,000 / group',
    icon: '☕',
    href: '/tours/coffee-ceremony',
    photo: '/images/tours/coffee-ceremony/guests-kettles.jpg',
    tags: ['Daytime', 'Coffee', 'Hands-on', 'Nishiki Market'],
    highlights: [
      'Brew two specialty coffees with your own hands',
      'Kyoto sweets paired with your coffee',
      'Take-home beans & your handwritten recipe',
    ],
  },
  {
    id: 'tea-ceremony',
    name: 'Matcha Tea Ceremony with an Urasenke Master',
    tagline: 'Certified Urasenke sensei. Whisk your own matcha. Central Kyoto.',
    description: 'Step into the meditative world of Japanese tea ceremony, led by a certified Urasenke master. Watch a complete temae demonstration, whisk your own bowl of matcha, and finish with seasonal wagashi and a tasting of three Japanese teas.',
    duration: '80 minutes',
    groupSize: 'Max 5 guests',
    time: 'Daytime',
    rating: null,
    reviews: null,
    price: '¥12,000 / adult',
    icon: '🍵',
    href: '/tours/tea-ceremony',
    photo: '/images/tours/tea-ceremony/guests-table.jpg',
    tags: ['Daytime', 'Tea Ceremony', 'Hands-on', 'Kawaramachi'],
    highlights: [
      'Full temae demonstration by an Urasenke-certified sensei',
      'Whisk your own bowl of matcha',
      'Seasonal wagashi & three-tea tasting',
    ],
  },
];
---

<BaseLayout
  title="Tours | OTAtrip Guide"
  description="Explore Kyoto with OTAtrip Guide. Evening sake tours, izakaya hopping in Pontocho, World Heritage walks with manga souvenirs, a hands-on coffee ceremony near Nishiki Market, and a matcha tea ceremony with an Urasenke master. Rated 4.9/5 on TripAdvisor."
  canonical="/tours"
>
  <!-- Header -->
  <section class="scanlines bg-nes-black py-16 text-center">
    <div class="relative z-10 max-w-3xl mx-auto px-4">
      <p class="px-eyebrow text-nes-amber mb-4 rpg-prefix">AVAILABLE QUESTS</p>
      <h1 class="font-pixel text-nes-white mb-4" style="font-size: clamp(1rem, 4vw, 2rem);">SELECT A TOUR</h1>
      <p class="font-sans text-gray-300 text-base">Small-group, English-language experiences led by local Kyoto experts.</p>
    </div>
  </section>

  <!-- Tour list -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="space-y-8">
      {tours.map((tour, i) => (
        <div class="dialogue-box overflow-hidden">
          {tour.photo && (
            <div class="mb-6 -mx-6 -mt-6 overflow-hidden border-b-2 border-nes-amber">
              <img src={tour.photo} alt={tour.name} class="w-full h-52 object-cover" style={tour.photoPosition ? `object-position: ${tour.photoPosition}` : undefined} loading="lazy" />
            </div>
          )}
          <div class="flex flex-col md:flex-row gap-6 items-start">
            <!-- Icon + number -->
            <div class="flex flex-col items-center gap-2 shrink-0">
              <div class="w-16 h-16 bg-neutral-900 border-2 border-nes-amber flex items-center justify-center text-4xl">
                {tour.icon}
              </div>
              <span class="px-label text-gray-400">QUEST {String(i + 1).padStart(2, '0')}</span>
            </div>

            <!-- Info -->
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <span class="px-label text-nes-cyan">{tour.time.toUpperCase()}</span>
                {tour.rating && (
                  <span class="px-label text-nes-amber"><span class="font-sans">★</span> {tour.rating} ({tour.reviews} reviews)</span>
                )}
              </div>
              <h2 class="font-dot text-xl md:text-2xl text-nes-white leading-snug mb-3">{tour.name}</h2>
              <p class="font-sans text-sm text-gray-300 leading-relaxed mb-4">{tour.description}</p>

              <ul class="space-y-1 mb-4">
                {tour.highlights.map(h => (
                  <li class="font-dot text-sm text-gray-200 flex items-start gap-2">
                    <span class="text-nes-green shrink-0">[OK]</span>{h}
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-x-5 gap-y-2 font-dot text-sm text-gray-300 mb-4">
                <span>⏱ {tour.duration}</span>
                <span>👥 {tour.groupSize}</span>
                <span>🌐 EN</span>
                {tour.price && <span class="text-nes-amber">{tour.price}</span>}
              </div>

              <div class="flex flex-wrap gap-2">
                {tour.tags.map(tag => (
                  <span class="px-label border border-gray-700 text-gray-400 px-2 py-1">{tag.toUpperCase()}</span>
                ))}
              </div>
            </div>

            <!-- CTA -->
            <div class="shrink-0 w-full md:w-auto mt-4 md:mt-0">
              <a href={tour.href} class="nes-btn nes-btn-gold block w-full md:w-auto text-center" data-track-label={`tours_index_${tour.href.split('/').pop()}`}>
                VIEW TOUR
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mini game CTA -->
    <div class="border border-gray-800 text-center mt-12 py-8 px-6">
      <p class="px-eyebrow text-nes-green mb-3">// MINI GAME</p>
      <h3 class="px-h2 mb-3">WANNA FEEL THE VIBE FIRST?</h3>
      <p class="font-sans text-sm text-gray-300 mb-5">Wander a pixel-art Gion at night, talk to the locals, and collect 3 stamps.</p>
      <a href="/game" class="nes-btn nes-btn-outline" data-track-label="tours_index_play_game">🎮 PLAY GION NIGHT QUEST</a>
    </div>

    <!-- Group CTA -->
    <div class="dialogue-box text-center mt-8">
      <p class="px-eyebrow text-nes-cyan mb-3">// FOR AGENCIES & GROUPS</p>
      <h3 class="px-h2 mb-4">NEED A CUSTOM TOUR?</h3>
      <p class="font-sans text-sm text-gray-300 mb-6 max-w-md mx-auto">Private bookings, custom routes, and group pricing available for travel agencies and corporate groups.</p>
      <a href="/groups" class="nes-btn nes-btn-gold" data-track-label="tours_index_group_options">VIEW GROUP OPTIONS</a>
    </div>
  </section>
</BaseLayout>
