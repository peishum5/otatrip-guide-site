---
import BaseLayout from '../../layouts/BaseLayout.astro';

const tours = [
  {
    id: 'gion-sake-walk',
    name: 'Gion Sake Walking Tour',
    tagline: 'Lantern-lit alleys. Local sake bars. Old Kyoto.',
    description: 'An intimate evening walk through Gion\'s most atmospheric streets. Visit three hand-picked local sake bars, taste Fushimi-style sake, and hear the stories behind Kyoto\'s most iconic neighborhood.',
    duration: '3 hours',
    groupSize: 'Max 10 guests',
    time: 'Evening',
    rating: '4.9',
    reviews: '100+',
    price: 'from ¥5,600',
    icon: '🏮',
    href: '/tours/gion-sake-walk',
    photo: '/images/tours/tour-gion-walk.jpg',
    tags: ['Evening', 'Sake', 'Walking', 'Gion'],
    highlights: [
      '3 sake tastings at curated local bars',
      'Walk Hanamikoji & Shinbashi',
      'Light snacks included',
    ],
  },
  {
    id: 'izakaya-hopping',
    name: 'Kyoto Izakaya Hopping',
    tagline: 'Pontocho & Gion backstreets. Real local izakayas.',
    description: 'Explore the vibrant backstreets of Kiyamachi and Pontocho with a local guide. Visit 2–3 izakayas that locals actually love — no tourist traps, no hidden commissions. Customizable for dietary preferences.',
    duration: '3 hours',
    groupSize: 'Small group',
    time: 'Evening',
    rating: null,
    reviews: null,
    price: 'from ¥4,160',
    icon: '🍻',
    href: '/tours/izakaya-hopping',
    photo: '/images/tours/izakaya/izakaya-guests.jpg',
    photoPosition: 'top',
    tags: ['Evening', 'Food', 'Walking', 'Pontocho'],
    highlights: [
      '2–3 local izakayas in Pontocho & Kiyamachi',
      'No hidden commissions — pay direct',
      'Customizable for dietary needs',
    ],
  },
  {
    id: 'shimogamo-manga-walk',
    name: 'Shimogamo Shrine & Manga Walk',
    tagline: 'World Heritage shrine. Cinematic photos. Custom manga souvenir.',
    description: 'A morning walk through ancient Shimogamo Shrine and Tadasu-no-Mori forest, finishing at the iconic Kamogawa Delta. We capture cinematic shots along the way — then turn them into a one-of-a-kind manga-style print just for you.',
    duration: 'Morning tour',
    groupSize: 'Small group',
    time: 'Morning',
    rating: null,
    reviews: null,
    price: 'from ¥8,500',
    icon: '⛩️',
    href: '/tours/shimogamo-manga-walk',
    photo: '/images/tours/shimogamo/photo-bridge.jpg',
    photoPosition: 'center 40%',
    tags: ['Morning', 'Walking', 'Shrine', 'Manga', 'Photo'],
    highlights: [
      'Shimogamo Shrine & Tadasu-no-Mori forest',
      'Original manga-style print souvenir',
      'High-res digital photos included',
    ],
  },
  {
    id: 'coffee-ceremony',
    name: 'Hands-On Coffee Ceremony with a Master',
    tagline: 'Hidden alley cafe. Japanese pour-over. Minutes from Nishiki Market.',
    description: 'Learn Japanese pour-over coffee at a hidden alley cafe a few minutes from Nishiki Market. Guided by a Master, you grind, bloom, and brew two different coffees, then compare them slowly over Kyoto sweets. Take home beans and your own recipe.',
    duration: '70 minutes',
    groupSize: 'Max 4 guests',
    time: 'Daytime',
    rating: null,
    reviews: null,
    price: 'from ¥8,000',
    icon: '☕',
    href: '/tours/coffee-ceremony',
    photo: '/images/tours/coffee-ceremony/ceremony-setting.jpg',
    tags: ['Daytime', 'Coffee', 'Hands-on', 'Nishiki Market'],
    highlights: [
      'Brew two specialty coffees with your own hands',
      'Kyoto sweets paired with your coffee',
      'Take-home beans & your handwritten recipe',
    ],
  },
];
---

<BaseLayout
  title="Tours | OTAtrip Guide"
  description="Explore Kyoto with OTAtrip Guide. Evening sake tours, izakaya hopping in Pontocho, World Heritage walks with manga souvenirs, and a hands-on coffee ceremony near Nishiki Market. Rated 4.9/5 on TripAdvisor."
  canonical="/tours"
>
  <!-- Header -->
  <section class="scanlines bg-washi py-16 text-center">
    <div class="relative z-10 max-w-3xl mx-auto px-4">
      <p class="font-display text-sm text-ai tracking-widest mb-4 rpg-prefix">Available Tours</p>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-sumi mb-4">Select a Tour</h1>
      <p class="font-sans text-sumi-soft text-sm">Small-group, English-language experiences led by local Kyoto experts.</p>
    </div>
  </section>

  <!-- Tour list -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="space-y-8">
      {tours.map((tour, i) => (
        <div class="dialogue-box overflow-hidden">
          {tour.photo && (
            <div class="mb-6 -mx-6 -mt-6 overflow-hidden border-b-2 border-washi-edge">
              <img src={tour.photo} alt={tour.name} class="w-full h-52 object-cover" style={tour.photoPosition ? `object-position: ${tour.photoPosition}` : undefined} loading="lazy" />
            </div>
          )}
          <div class="flex flex-col md:flex-row gap-6 items-start">
            <!-- Icon + number -->
            <div class="flex flex-col items-center gap-2 shrink-0">
              <div class="w-16 h-16 bg-washi border-2 border-washi-edge flex items-center justify-center text-4xl">
                {tour.icon}
              </div>
              <span class="font-sans text-xs text-sumi-soft">Tour {String(i + 1).padStart(2, '0')}</span>
            </div>

            <!-- Info -->
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <span class="font-display text-sm text-ai tracking-widest">{tour.time}</span>
                {tour.rating && (
                  <span class="font-display text-sm text-shu">★ {tour.rating} ({tour.reviews} reviews)</span>
                )}
              </div>
              <h2 class="font-display text-lg font-bold text-sumi leading-relaxed mb-2">{tour.name}</h2>
              <p class="font-sans text-sm text-sumi-soft leading-relaxed mb-4">{tour.description}</p>

              <ul class="space-y-1 mb-4">
                {tour.highlights.map(h => (
                  <li class="font-sans text-sm text-sumi-soft flex items-start gap-2">
                    <span class="text-matsu shrink-0">✓</span>{h}
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-4 font-sans text-xs text-sumi-soft mb-3">
                <span>⏱ {tour.duration}</span>
                <span>👥 {tour.groupSize}</span>
                <span>🌐 EN</span>
                {tour.price && <span class="text-shu font-semibold">{tour.price}</span>}
              </div>

              <div class="flex flex-wrap gap-2">
                {tour.tags.map(tag => (
                  <span class="font-sans text-xs border border-washi-edge text-sumi-soft px-2 py-0.5">{tag}</span>
                ))}
              </div>
            </div>

            <!-- CTA -->
            <div class="shrink-0 w-full md:w-auto mt-4 md:mt-0">
              <a href={tour.href} class="nes-btn nes-btn-gold block w-full md:w-auto text-center">
                View Tour
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Mini game CTA -->
    <div class="border border-washi-edge bg-washi-deep text-center mt-12 py-8 px-6">
      <p class="font-display text-sm text-ai tracking-widest mb-3">Mini Game</p>
      <h3 class="font-display text-lg font-bold text-sumi leading-relaxed mb-3">Wanna Feel the Vibe First?</h3>
      <p class="font-sans text-sm text-sumi-soft mb-5">Wander a tiny pixel-art Gion, talk to the locals, and collect all 3 stamps.</p>
      <a href="/game" class="nes-btn nes-btn-outline">🎮 Play Gion Night Quest</a>
    </div>

    <!-- Group CTA -->
    <div class="dialogue-box text-center mt-8">
      <p class="font-display text-sm text-ai tracking-widest mb-3">For Agencies & Groups</p>
      <h3 class="font-display text-xl font-bold text-sumi leading-relaxed mb-4">Need a Custom Tour?</h3>
      <p class="font-sans text-sm text-sumi-soft mb-6 max-w-md mx-auto">Private bookings, custom routes, and group pricing available for travel agencies and corporate groups.</p>
      <a href="/groups" class="nes-btn nes-btn-gold">View Group Options</a>
    </div>
  </section>
</BaseLayout>
