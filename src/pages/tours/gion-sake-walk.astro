---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import StickyBookBar from '../../components/StickyBookBar.astro';
import GroupCTA from '../../components/GroupCTA.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import { BOKUN_LOADER_SRC } from '../../config/site';

const highlights = [
  'See Pontocho and the Kamo River, then cross into Gion at Minamiza, Japan\'s oldest theatre',
  'Stroll Hanamikoji Street in Gion Kobu, Kyoto\'s largest geisha district',
  'Crawl through the stone at Yasui-Konpiragu, the shrine for cutting bad ties',
  'Yasaka Pagoda, Ninenzaka and Nene-no-Michi, ending at Yasaka Shrine',
  'Small groups (max 10 guests), about 2.7 km in 90 minutes',
  'A small bottle of Kyoto sake for a toast at the start (non-drinkers welcome)',
];

const timeline = [
  { time: 'START', desc: 'Meet outside Hankyu Kyoto-Kawaramachi Station Exit 1B, beside McDonald\'s. Your guide is holding an "OTAtrip Guide" sign. Introductions and a toast to start the evening.' },
  { time: '+8\'',  desc: 'Pontocho and the Kamo River — one of Kyoto\'s five geisha districts, summer river decks, and Japan\'s oldest working elevator at Toka Saikan.' },
  { time: '+15\'', desc: 'Minamiza — cross the river into Gion. Japan\'s oldest theatre, and the surprising story of how kabuki began.' },
  { time: '+25\'', desc: 'Shijo Street — the shops of Gion, dango and yatsuhashi, ochaya teahouses, and the story of the Gion Matsuri festival.' },
  { time: '+33\'', desc: 'Hanamikoji Street — geiko and maiko, and how to tell them apart.' },
  { time: '+45\'', desc: 'Yasui-Konpiragu — a shrine famous for cutting bad ties. Crawl through the stone and learn how to pray at a shrine.' },
  { time: '+55\'', desc: 'Yasaka Pagoda (Hokan-ji) — the five-story pagoda first founded in 589. Photo time.' },
  { time: '+65\'', desc: 'Ninenzaka — the stone-paved slope with a Starbucks inside a traditional townhouse.' },
  { time: '+72\'', desc: 'Nene-no-Michi and Kodaiji — the story of Hideyoshi and his wife Nene.' },
  { time: '+80\'', desc: 'Yasaka Shrine — the shrine Gion grew up around, and home of the Gion Matsuri.' },
  { time: '+90\'', desc: 'Tour ends at Yasaka Shrine. Your guide is happy to recommend where to go next.' },
];

const faqs = [
  {
    q: 'How much walking is involved?',
    a: 'About 2.7 km over 90 minutes, on stone-paved streets with a couple of gentle slopes. The pace is relaxed with stops along the way. Comfortable flat shoes are recommended.',
  },
  {
    q: 'Where does the tour start and end?',
    a: 'It starts outside Hankyu Kyoto-Kawaramachi Station Exit 1B, beside McDonald\'s, and ends at Yasaka Shrine.',
  },
  {
    q: 'Is admission to the shrines and temples included?',
    a: 'All stops on this tour are free to enter. At Yasui-Konpiragu, the paper for making a wish is an optional ¥100 offering.',
  },
  {
    q: 'What if it rains?',
    a: 'The tour runs in light rain — Gion is beautiful when the stones are wet. In heavy rain or a typhoon we may cancel, and we will contact you.',
  },
  {
    q: 'Is there any drinking on the tour?',
    a: 'Just a little. Each guest gets one small bottle of Kyoto sake for a toast at the start. The tour is about Gion itself, so you are welcome to join without drinking. The drinking age in Japan is 20.',
  },
  {
    q: 'What language is the tour in?',
    a: 'The tour is conducted in English.',
  },
  {
    q: 'Can I book for a private group?',
    a: 'Yes. Private bookings are available for groups of 2–8. Contact us via the Groups page.',
  },
];

const photos = [
  { src: '/images/tours/gion/yasaka-night.jpg',   alt: 'Yasaka Pagoda lit up at night, Gion' },
  { src: '/images/tours/gion/maiko-pagoda.jpg',   alt: 'Maiko in front of Yasaka Pagoda' },
  { src: '/images/tours/tour-yasaka-gate.jpg',    alt: 'Group at Yasaka Shrine gate at night' },
  { src: '/images/tours/gion/maiko-alley.jpg',    alt: 'Maiko walking through a Gion alley', tall: true },
  { src: '/images/tours/tour-gion-walk.jpg',      alt: 'Walking through Gion under lantern light' },
  { src: '/images/tours/gion/maiko-walk-1.jpg',   alt: 'Maiko walking in Gion' },
  { src: '/images/tours/tour-alley-group.jpg',    alt: 'Guide explaining in a Gion alley' },
  { src: '/images/tours/gion/maiko-walk-2.jpg',   alt: 'Maiko in colorful kimonos, Gion' },
  { src: '/images/tours/tour-guide.jpg',          alt: 'Local guide pointing out Kyoto landmarks' },
  { src: '/images/tours/tour-shrine-stone.jpg',   alt: 'Guest at Yasaka Shrine stone tunnel' },
  { src: '/images/tours/tour-night-city.jpg',     alt: 'Group walking through Kyoto at night' },
  { src: '/images/tours/tour-kiyomizu-night.jpg', alt: 'Kiyomizu-dera pagoda at night' },
  { src: '/images/tours/tour-sake-toast.jpg',     alt: 'Guests making a toast at the start of the tour' },
  { src: '/images/tours/tour-sake-pour.jpg',      alt: 'Guide pouring a welcome toast for guests' },
];
---

<BaseLayout
  title="Kyoto Gion Night Walk: Hidden Gems & Geisha | OTAtrip Guide"
  description="A 90-minute walk through Gion's stone-paved alleys and geisha streets, from Pontocho to Yasaka Shrine, with a guide who lives in Kyoto. Starts every 2 hours from 15:30. Small groups, max 10 guests. Rated 4.9/5."
  canonical="/tours/gion-sake-walk"
  ogImage="/images/tours/gion/hero.jpg"
>
  <Fragment slot="head">
    <script is:inline type="text/javascript" src={BOKUN_LOADER_SRC} async></script>
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-nes-black overflow-hidden">
    <img
      src="/images/tours/gion/hero.jpg"
      alt="Tour guests laughing together in Gion at night"
      class="absolute inset-0 w-full h-full object-cover opacity-60"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-nes-black via-nes-black/60 to-transparent"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 py-24 md:py-32">
      <p class="font-pixel text-[0.7rem] leading-relaxed text-nes-amber mb-4 rpg-prefix">WALKING TOUR · GION DISTRICT</p>
      <h1 class="font-dot text-4xl md:text-5xl text-nes-white leading-tight mb-5">
        Kyoto Gion Night Walk: Hidden Gems & Geisha
      </h1>
      <p class="font-sans text-gray-300 text-base leading-relaxed mb-8 max-w-xl">
        Walk the stone-paved alleys of Kyoto's most iconic neighborhood.
        Hanamikoji, Yasaka Pagoda, Ninenzaka and Yasaka Shrine — guided by someone who lives in Kyoto.
      </p>
      <div class="flex flex-wrap gap-x-8 gap-y-4 mb-8">
        {[
          { label: 'Duration', value: '90 min' },
          { label: 'Group size', value: 'Max 10' },
          { label: 'Language', value: 'English' },
          { label: 'Rating', value: '★ 4.9 / 5' },
          { label: 'Price', value: 'from ¥5,600' },
        ].map(item => (
          <div>
            <div class="font-dot text-xl text-nes-amber">{item.value}</div>
            <div class="px-label text-gray-300 mt-1">{item.label.toUpperCase()}</div>
          </div>
        ))}
      </div>
      <a href="#booking" class="nes-btn nes-btn-gold" data-track-label="tour_hero_book_gion-sake-walk">BOOK YOUR SPOT</a>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-12">

    <!-- Highlights -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">WHAT'S INCLUDED</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-3">
        {highlights.map(item => (
          <div class="flex items-start gap-3 bg-neutral-900 border border-gray-800 px-4 py-3">
            <span class="px-label text-nes-green shrink-0 pt-1">[OK]</span>
            <span class="font-sans text-gray-300 text-sm leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Photo gallery -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">TOUR PHOTOS</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="gallery-grid grid grid-cols-2 md:grid-cols-3 gap-2">
        {photos.map((photo, i) => (
          <button
            type="button"
            class={`overflow-hidden border border-gray-800 cursor-zoom-in group${photo.tall ? ' row-span-2' : ''}`}
            style="touch-action:manipulation"
            data-lb-index={i}
            aria-label={`Enlarge: ${photo.alt}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover transition-opacity group-hover:opacity-80"
              loading="lazy"
            />
          </button>
        ))}
      </div>
    </section>

    <!-- Lightbox -->
    <div
      id="lightbox"
      class="fixed inset-0 z-50 items-center justify-center bg-black/90"
      style="display:none"
      role="dialog"
      aria-modal="true"
      aria-label="Enlarged photo"
    >
      <button id="lb-close" type="button" class="absolute top-4 right-5 font-pixel text-[0.9rem] text-nes-amber hover:text-nes-white z-10" style="touch-action:manipulation">[ X ]</button>
      <button id="lb-prev" type="button" class="absolute left-3 font-pixel text-[1.2rem] text-nes-cyan hover:text-nes-white z-10 px-2 py-4" style="touch-action:manipulation">◀</button>
      <button id="lb-next" type="button" class="absolute right-3 font-pixel text-[1.2rem] text-nes-cyan hover:text-nes-white z-10 px-2 py-4" style="touch-action:manipulation">▶</button>
      <figure class="flex flex-col items-center max-w-[90vw] max-h-[90vh]">
        <img id="lb-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain border border-gray-700" />
        <figcaption id="lb-caption" class="mt-3 font-sans text-xs text-gray-400 text-center"></figcaption>
      </figure>
    </div>

    <!-- Timeline -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">TOUR TIMELINE</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="space-y-5">
        {timeline.map(item => (
          <div class="flex items-start gap-5">
            <span class="font-pixel text-[0.625rem] text-nes-cyan shrink-0 w-14 text-right pt-1.5">{item.time}</span>
            <div class="flex-1 border-l border-gray-700 pl-5 pb-3">
              <p class="font-sans text-sm text-gray-300 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Meeting point -->
    <section class="mb-12">
      <div class="dialogue-box">
        <p class="px-eyebrow text-nes-cyan mb-4">// MEETING POINT</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="font-sans text-nes-white font-semibold text-sm mb-1">Hankyu Kyoto-Kawaramachi Station, Exit 1B</p>
            <p class="font-sans text-gray-400 text-xs leading-relaxed mb-3">
              Outside on the sidewalk beside McDonald's, in front of the dark wall. Please do not wait inside McDonald's or inside the station.
              Your guide will be holding a sign that reads <span class="text-nes-white">"OTAtrip Guide"</span>.
              <a href="/guest/gion-night-walk-meeting-point" class="text-nes-cyan hover:text-nes-amber">See the photo of the exact spot</a>.
            </p>
            <p class="font-sans text-gray-400 text-xs mb-3">
              This is a group tour. Please arrive a few minutes early — late arrivals may cause the tour to start without you.
            </p>
            <a
              href="https://maps.app.goo.gl/J7SmSwzVmAfjZJs36"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-label text-nes-cyan hover:text-nes-amber transition-colors"
            >
              ▶ OPEN IN GOOGLE MAPS
            </a>
          </div>
          <div class="space-y-2 font-dot text-base">
            {[
              { k: 'Start times', v: '15:30 / 17:30 / 19:30 / 21:30*' },
              { k: 'Duration', v: '90 min' },
              { k: 'Ends at', v: 'Yasaka Shrine' },
            ].map(row => (
              <div class="flex justify-between border-b border-gray-800 pb-2">
                <span class="text-gray-400">{row.k}</span>
                <span class="text-nes-white">{row.v}</span>
              </div>
            ))}
            <p class="font-sans text-xs text-gray-400">* Start times vary by day. Please check the calendar below for available times.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking -->
    <section id="booking" class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">BOOK YOUR SPOT</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <p class="font-sans text-gray-300 text-sm mb-6">Book early to take advantage of early-bird pricing.</p>
      <BookingWidget widgetPath="experience-calendar/901507" />
    </section>

    <!-- Reviews -->
    <ReviewsSection />

    <!-- Group CTA -->
    <GroupCTA />

    <!-- FAQ -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">FAQ</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="border border-gray-800 bg-neutral-900 group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-dot text-base md:text-lg leading-snug text-nes-white hover:text-nes-amber transition-colors">
              {faq.q}
              <span class="ml-4 text-gray-400 shrink-0 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-4 font-sans text-sm text-gray-400 leading-relaxed border-t border-gray-800 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "Kyoto Gion Night Walk: Hidden Gems & Geisha",
    "description": "A 90-minute walking tour through Gion's stone-paved alleys and geisha streets, from Pontocho to Yasaka Shrine. Starts every 2 hours from 15:30. Small groups of max 10 guests.",
    "url": "https://otatrip.guide/tours/gion-sake-walk",
    "image": "https://otatrip.guide/images/tours/gion/hero.jpg",
    "provider": {
      "@type": "TouristInformationCenter",
      "name": "OTAtrip Guide",
      "url": "https://otatrip.guide"
    },
    "offers": {
      "@type": "Offer",
      "price": "5600",
      "priceCurrency": "JPY",
      "availability": "https://schema.org/InStock",
      "url": "https://otatrip.guide/tours/gion-sake-walk#booking"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "200"
    }
  })} />
<style>
  .gallery-grid {
    grid-auto-rows: 140px;
    grid-auto-flow: dense;
  }
  @media (min-width: 768px) {
    .gallery-grid { grid-auto-rows: 200px; }
  }
</style>

<script define:vars={{ photos }}>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCaption = document.getElementById('lb-caption');
  let current = 0;

  function show(index) {
    current = (index + photos.length) % photos.length;
    lbImg.src = photos[current].src;
    lbImg.alt = photos[current].alt;
    lbCaption.textContent = photos[current].alt;
    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lb.style.display = 'none';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-lb-index]').forEach(btn => {
    btn.addEventListener('click', () => show(Number(btn.dataset.lbIndex)));
  });

  document.getElementById('lb-close').addEventListener('click', close);
  document.getElementById('lb-prev').addEventListener('click', () => show(current - 1));
  document.getElementById('lb-next').addEventListener('click', () => show(current + 1));

  lb.addEventListener('click', e => { if (e.target === lb) close(); });

  document.addEventListener('keydown', e => {
    if (lb.style.display === 'none') return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />
  <StickyBookBar price="from ¥5,600" slug="gion-sake-walk" />
</BaseLayout>
