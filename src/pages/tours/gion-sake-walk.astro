---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import GroupCTA from '../../components/GroupCTA.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import { BOKUN_LOADER_SRC } from '../../config/site';

const highlights = [
  'Walk the iconic stone-paved alleys of Gion and Higashiyama',
  'Stroll Hanamikoji Street — Kyoto\'s most famous geisha district',
  'Visit Yasui-Konpiragu shrine, Hokan-ji Temple (Yasaka Pagoda), and Yasaka Shrine',
  'Discover Nene-no-Michi, Sannenzaka, and Sanneizaka at your own pace',
  'Hear stories of geiko, maiko, and the traditional entertainment district',
  'Small groups (max 10 guests) for an intimate, unhurried experience',
];

const timeline = [
  { time: 'START', desc: 'Meet at Shijo Kiyamachi. Your guide is holding an "Otatrip Guide" sign. Brief intro and overview.' },
  { time: '+10\'', desc: 'Stroll along the Kamogawa River and enter the Gion district.' },
  { time: '+20\'', desc: 'Hanamikoji Street — Kyoto\'s most iconic geisha street, lined with traditional machiya teahouses.' },
  { time: '+30\'', desc: 'Yasui-Konpiragu — a unique Shinto shrine famous for its Enkiri-Enmusubi stone and relationship rituals.' },
  { time: '+45\'', desc: 'Hokan-ji Temple — the five-story Yasaka Pagoda, one of Kyoto\'s most recognizable landmarks.' },
  { time: '+60\'', desc: 'Sannenzaka & Sanneizaka — charming stone-paved lanes lined with traditional shops and cafes.' },
  { time: '+70\'', desc: 'Nene-no-Michi — a serene stone path connecting Kodaiji Temple to Maruyama Park.' },
  { time: '+80\'', desc: 'Yasaka Shrine — the spiritual heart of Gion and home of the grand Gion Matsuri festival.' },
  { time: '+90\'', desc: 'Tour ends. Optional: continue exploring the area on your own.' },
];

const faqs = [
  {
    q: 'How much walking is involved?',
    a: 'The tour covers the Gion and Higashiyama area — roughly 2–3 km on stone-paved streets and gentle slopes. The pace is relaxed with stops along the way. Comfortable flat shoes are recommended.',
  },
  {
    q: 'Is admission to the shrines and temples included?',
    a: 'All stops on this tour are free to enter. No admission tickets are needed.',
  },
  {
    q: 'What if it rains?',
    a: 'The tour runs rain or shine — Gion is beautiful in the rain. Bring an umbrella or pick up a compact one at a nearby konbini.',
  },
  {
    q: 'What language is the tour in?',
    a: 'The tour is conducted in English.',
  },
  {
    q: 'Can I book for a private group?',
    a: 'Yes. Private bookings are available for groups of 2–8. Contact us via the Groups page.',
  },
];

const photos = [
  { src: '/images/tours/gion/yasaka-night.jpg',   alt: 'Yasaka Pagoda lit up at night, Gion' },
  { src: '/images/tours/gion/maiko-pagoda.jpg',   alt: 'Maiko in front of Yasaka Pagoda' },
  { src: '/images/tours/tour-yasaka-gate.jpg',    alt: 'Group at Yasaka Shrine gate at night' },
  { src: '/images/tours/gion/maiko-alley.jpg',    alt: 'Maiko walking through a Gion alley', tall: true },
  { src: '/images/tours/tour-sake-pour.jpg',      alt: 'Sake being poured at a local bar' },
  { src: '/images/tours/tour-gion-walk.jpg',      alt: 'Walking through Gion under lantern light' },
  { src: '/images/tours/gion/maiko-walk-1.jpg',   alt: 'Maiko walking in Gion' },
  { src: '/images/tours/tour-sake-toast.jpg',     alt: 'Guests toasting with sake shots' },
  { src: '/images/tours/tour-alley-group.jpg',    alt: 'Guide explaining in a Gion alley' },
  { src: '/images/tours/gion/maiko-walk-2.jpg',   alt: 'Maiko in colorful kimonos, Gion' },
  { src: '/images/tours/tour-guide.jpg',          alt: 'Local guide pointing out Kyoto landmarks' },
  { src: '/images/tours/tour-shrine-stone.jpg',   alt: 'Guest at Yasaka Shrine stone tunnel' },
  { src: '/images/tours/tour-night-city.jpg',     alt: 'Group walking through Kyoto at night' },
  { src: '/images/tours/tour-kiyomizu-night.jpg', alt: 'Kiyomizu-dera pagoda at night' },
];
---

<BaseLayout
  title="Kyoto Gion Night Walk: Sake, Hidden Gems & Geisha | OTAtrip Guide"
  description="A 90-minute walk through Gion's iconic stone-paved alleys with sake tastings at 3 local bars. 4 daily slots: 15:30 / 17:30 / 19:30 / 21:30. Small groups, max 10 guests. Rated 4.9/5."
  canonical="/tours/gion-sake-walk"
  ogImage="/images/tours/gion/hero.jpg"
>
  <Fragment slot="head">
    <script is:inline type="text/javascript" src={BOKUN_LOADER_SRC} async></script>
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-sumi overflow-hidden">
    <img
      src="/images/tours/gion/hero.jpg"
      alt="Tour guests laughing together in Gion at night"
      class="absolute inset-0 w-full h-full object-cover opacity-60"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 py-24 md:py-32">
      <p class="font-display text-sm text-kin tracking-widest mb-4 rpg-prefix">Walking Tour · Gion District</p>
      <h1 class="font-display text-3xl md:text-4xl font-bold text-white leading-tight mb-4">
        Kyoto Gion Night Walk: Sake, Hidden Gems & Geisha
      </h1>
      <p class="font-sans text-gray-200 text-base leading-relaxed mb-8 max-w-xl">
        Walk the stone-paved alleys of Kyoto's most iconic neighborhood.
        Gion, Hanamikoji, Yasaka Pagoda, Nene-no-Michi — guided by someone who calls Gion home.
      </p>
      <div class="flex flex-wrap gap-6 mb-8">
        {[
          { label: 'Duration', value: '90 min' },
          { label: 'Group size', value: 'Max 10' },
          { label: 'Language', value: 'English' },
          { label: 'Rating', value: '★ 4.9 / 5' },
          { label: 'Price', value: 'from ¥5,600' },
        ].map(item => (
          <div>
            <div class="font-display text-base font-semibold text-white">{item.value}</div>
            <div class="font-sans text-xs text-gray-300">{item.label}</div>
          </div>
        ))}
      </div>
      <a href="#booking" class="nes-btn nes-btn-gold">Book Your Spot</a>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-12">

    <!-- Highlights -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-sumi">What's Included</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-3">
        {highlights.map(item => (
          <div class="flex items-start gap-3 bg-washi-deep border border-washi-edge px-4 py-3">
            <span class="font-display text-sm text-matsu shrink-0">✓</span>
            <span class="font-sans text-sumi-soft text-sm leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Photo gallery -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-sumi">Tour Photos</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <div class="gallery-grid grid grid-cols-2 md:grid-cols-3 gap-2">
        {photos.map((photo, i) => (
          <button
            type="button"
            class={`overflow-hidden border border-washi-edge cursor-zoom-in group${photo.tall ? ' row-span-2' : ''}`}
            style="touch-action:manipulation"
            data-lb-index={i}
            aria-label={`Enlarge: ${photo.alt}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover transition-opacity group-hover:opacity-80"
              loading="lazy"
            />
          </button>
        ))}
      </div>
    </section>

    <!-- Lightbox -->
    <div
      id="lightbox"
      class="fixed inset-0 z-50 items-center justify-center bg-black/90"
      style="display:none"
      role="dialog"
      aria-modal="true"
      aria-label="Enlarged photo"
    >
      <button id="lb-close" type="button" class="absolute top-4 right-5 font-display text-lg text-white hover:text-kin z-10" style="touch-action:manipulation">✕</button>
      <button id="lb-prev" type="button" class="absolute left-3 font-display text-2xl text-white hover:text-kin z-10 px-2 py-4" style="touch-action:manipulation">◀</button>
      <button id="lb-next" type="button" class="absolute right-3 font-display text-2xl text-white hover:text-kin z-10 px-2 py-4" style="touch-action:manipulation">▶</button>
      <figure class="flex flex-col items-center max-w-[90vw] max-h-[90vh]">
        <img id="lb-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain border border-white/20" />
        <figcaption id="lb-caption" class="mt-3 font-sans text-xs text-gray-300 text-center"></figcaption>
      </figure>
    </div>

    <!-- Timeline -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-sumi">Tour Timeline</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <div class="space-y-5">
        {timeline.map(item => (
          <div class="flex items-start gap-5">
            <span class="font-display text-sm text-ai shrink-0 w-12 text-right pt-1">{item.time}</span>
            <div class="flex-1 border-l border-washi-edge pl-5 pb-3">
              <p class="font-sans text-sm text-sumi-soft leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Meeting point -->
    <section class="mb-12">
      <div class="dialogue-box">
        <p class="font-display text-sm text-ai tracking-widest mb-4">Meeting Point</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="font-sans text-sumi font-semibold text-sm mb-1">Shijo Kiyamachi</p>
            <p class="font-sans text-sumi-soft text-xs leading-relaxed mb-3">
              On Kiyamachi Street, slightly south of Shijo — between McDonald's and the Japanese restaurant Kikunoi Roan.
              Your guide will be holding a sign that reads <span class="text-sumi font-medium">"Otatrip Guide"</span>.
            </p>
            <p class="font-sans text-sumi-soft text-xs mb-3">
              This is a group tour. Please arrive a few minutes early — late arrivals may cause the tour to start without you.
            </p>
            <a
              href="https://maps.app.goo.gl/J7SmSwzVmAfjZJs36"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 font-display text-sm text-ai hover:text-shu transition-colors"
            >
              ▶ Open in Google Maps
            </a>
          </div>
          <div class="space-y-2 font-sans text-sm">
            {[
              { k: 'Start times', v: '15:30 / 17:30 / 19:30 / 21:30' },
              { k: 'Duration', v: '90 min' },
            ].map(row => (
              <div class="flex justify-between border-b border-washi-edge pb-2">
                <span class="text-sumi-soft">{row.k}</span>
                <span class="text-sumi">{row.v}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Booking -->
    <section id="booking" class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-sumi">Book Your Spot</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <p class="font-sans text-sumi-soft text-sm mb-6">Book early to take advantage of early-bird pricing.</p>
      <BookingWidget widgetPath="experience-calendar/901507" />
    </section>

    <!-- Reviews -->
    <ReviewsSection />

    <!-- Group CTA -->
    <GroupCTA />

    <!-- FAQ -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-sumi">FAQ</h2>
        <div class="flex-1 border-t border-washi-edge"></div>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="border border-washi-edge bg-washi-deep group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-display text-base text-sumi hover:text-shu transition-colors">
              {faq.q}
              <span class="ml-4 text-sumi-soft shrink-0 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-4 font-sans text-sm text-sumi-soft leading-relaxed border-t border-washi-edge pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "Kyoto Gion Night Walk: Sake, Hidden Gems & Geisha",
    "description": "A 90-minute walking tour through Gion's stone-paved alleys with sake tastings at 3 local bars. 4 daily slots. Small groups of max 10 guests.",
    "url": "https://otatrip.guide/tours/gion-sake-walk",
    "provider": {
      "@type": "TouristInformationCenter",
      "name": "OTAtrip Guide",
      "url": "https://otatrip.guide"
    },
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "200"
    }
  })} />
<style>
  .gallery-grid {
    grid-auto-rows: 140px;
    grid-auto-flow: dense;
  }
  @media (min-width: 768px) {
    .gallery-grid { grid-auto-rows: 200px; }
  }
</style>

<script define:vars={{ photos }}>
  const lb = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCaption = document.getElementById('lb-caption');
  let current = 0;

  function show(index) {
    current = (index + photos.length) % photos.length;
    lbImg.src = photos[current].src;
    lbImg.alt = photos[current].alt;
    lbCaption.textContent = photos[current].alt;
    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lb.style.display = 'none';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-lb-index]').forEach(btn => {
    btn.addEventListener('click', () => show(Number(btn.dataset.lbIndex)));
  });

  document.getElementById('lb-close').addEventListener('click', close);
  document.getElementById('lb-prev').addEventListener('click', () => show(current - 1));
  document.getElementById('lb-next').addEventListener('click', () => show(current + 1));

  lb.addEventListener('click', e => { if (e.target === lb) close(); });

  document.addEventListener('keydown', e => {
    if (lb.style.display === 'none') return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
</BaseLayout>
