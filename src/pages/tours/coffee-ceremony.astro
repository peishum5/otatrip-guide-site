---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWidget from '../../components/BookingWidget.astro';
import StickyBookBar from '../../components/StickyBookBar.astro';
import GroupCTA from '../../components/GroupCTA.astro';
import ReviewsSection from '../../components/ReviewsSection.astro';
import { BOKUN_LOADER_SRC } from '../../config/site';

const highlights = [
  'Brew two different specialty coffees with your own hands',
  'Welcome cup of hand-drip coffee, brewed by the Master',
  'Kyoto sweets paired with your coffee',
  'Take-home: 30g of specialty beans in Japanese craft packaging',
  'Certificate of completion, with your recipe handwritten on the back',
  'All equipment provided — English-speaking guidance throughout',
];

const timeline = [
  { time: 'Start', desc: 'Welcome. The Master greets you and brews you a cup of hand-drip coffee — the taste you will be aiming for.' },
  { time: '+10m', desc: 'The story of Japanese coffee. A short, fun talk with quiz questions. Smell and compare today’s beans.' },
  { time: '+20m', desc: 'Watch the Master brew one cup from start to finish: the grind, the water temperature, the bloom, the slow circular pour.' },
  { time: '+30m', desc: 'Your turn. With the Master beside you, brew two different coffees with your own hands.' },
  { time: '+50m', desc: 'Tasting, with Kyoto sweets. Compare your two coffees side by side — this is where the differences really click.' },
  { time: '+65m', desc: 'Wrap-up. Questions, photos, and your take-home set, plus the Master’s favorite local Kyoto spots.' },
];

const faqs = [
  {
    q: 'Do I need any coffee experience?',
    a: 'Not at all. Complete beginners are welcome. The Master guides every step, from the grind to the pour.',
  },
  {
    q: 'Can children join?',
    a: 'Yes. Children under 12 are welcome with a paying adult.',
  },
  {
    q: 'I have a food allergy. Can you adjust?',
    a: 'Yes. Please tell us about any food allergies when you book — the coffee and sweets can be adjusted.',
  },
  {
    q: 'Is the workshop in English?',
    a: 'Yes, it is conducted entirely in English. No Japanese required.',
  },
  {
    q: 'How do I find the cafe?',
    a: 'The cafe is tucked down a small alley a few minutes from Nishiki Market. Look for the noren (shop curtain) at the end of the alley, and please arrive 5 minutes before your start time.',
  },
];
---

<BaseLayout
  title="Hands-On Coffee Ceremony with a Master — Nishiki Market | OTAtrip Guide"
  description="Learn Japanese pour-over coffee at a hidden alley cafe a few minutes from Nishiki Market, Kyoto. Grind, bloom, and brew two coffees with a Master, then compare them over Kyoto sweets. 70 minutes, max 4 guests."
  canonical="/tours/coffee-ceremony"
  ogImage="/images/tours/coffee-ceremony/master-lecture.jpg"
>
  <Fragment slot="head">
    <script is:inline type="text/javascript" src={BOKUN_LOADER_SRC} async></script>
  </Fragment>

  <!-- Hero -->
  <section class="relative bg-nes-black overflow-hidden">
    <img
      src="/images/tours/coffee-ceremony/master-lecture.jpg"
      alt="The Master talking to guests at the start of the coffee workshop"
      class="absolute inset-0 w-full h-full object-cover opacity-60"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-nes-black via-nes-black/60 to-transparent"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 py-24 md:py-32">
      <p class="font-pixel text-[0.7rem] leading-relaxed text-nes-amber mb-4 rpg-prefix">DAYTIME WORKSHOP · NEAR NISHIKI MARKET</p>
      <h1 class="font-dot text-4xl md:text-5xl text-nes-white leading-tight mb-5">
        Hands-On Coffee Ceremony with a Master
      </h1>
      <p class="font-sans text-gray-300 text-base leading-relaxed mb-8 max-w-xl">
        Japan brews coffee with the same care it gives to tea.
        In a hidden alley cafe near Nishiki Market, you grind, bloom, and brew two coffees with a Master —
        then compare them slowly over Kyoto sweets.
      </p>
      <div class="flex flex-wrap gap-x-8 gap-y-4 mb-8">
        {[
          { label: 'Duration', value: '70 minutes' },
          { label: 'Group size', value: 'Max 4 guests' },
          { label: 'Language', value: 'English' },
          { label: 'Time', value: 'Daytime' },
          { label: 'Price', value: '¥24,000 / group' },
        ].map(item => (
          <div>
            <div class="font-dot text-xl text-nes-amber">{item.value}</div>
            <div class="px-label text-gray-300 mt-1">{item.label.toUpperCase()}</div>
          </div>
        ))}
      </div>
      <a href="#booking" class="nes-btn nes-btn-gold" data-track-label="tour_hero_book_coffee-ceremony">BOOK YOUR SPOT</a>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 py-12">

    <!-- Highlights -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">WHAT'S INCLUDED</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="grid md:grid-cols-2 gap-3">
        {highlights.map(item => (
          <div class="flex items-start gap-3 bg-neutral-900 border border-gray-800 px-4 py-3">
            <span class="px-label text-nes-green shrink-0 pt-1">[OK]</span>
            <span class="font-sans text-gray-300 text-sm leading-relaxed">{item}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Photo gallery -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">WORKSHOP PHOTOS</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="columns-2 md:columns-3 gap-2 space-y-2">
        {[
          { src: '/images/tours/coffee-ceremony/lecture-quiz.jpg',   alt: 'The Master sharing the story of Japanese coffee with the group' },
          { src: '/images/tours/coffee-ceremony/grinder-demo.jpg',   alt: 'The Master demonstrating the coffee grinder at each guest\'s station' },
          { src: '/images/tours/coffee-ceremony/workshop-table.jpg', alt: 'Guests at the workshop table, each with their own brewing station' },
          { src: '/images/tours/coffee-ceremony/hands-on-pour.jpg',  alt: 'A guest pouring water over the filter while family films the moment' },
          { src: '/images/tours/coffee-ceremony/guests-kettles.jpg', alt: 'Smiling guests holding gooseneck kettles, ready to brew' },
          { src: '/images/tours/coffee-ceremony/group-photo.jpg',    alt: 'Guests posing for a group photo at the end of the workshop' },
        ].map(photo => (
          <div class="break-inside-avoid overflow-hidden border border-gray-800">
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </section>

    <!-- Timeline -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">HOW THE 70 MINUTES UNFOLD</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="space-y-5">
        {timeline.map(item => (
          <div class="flex items-start gap-5">
            <span class="font-pixel text-[0.625rem] text-nes-cyan shrink-0 w-14 text-right pt-1.5">{item.time}</span>
            <div class="flex-1 border-l border-gray-700 pl-5 pb-3">
              <p class="font-sans text-sm text-gray-300 leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Meeting point -->
    <section class="mb-12">
      <div class="dialogue-box">
        <p class="px-eyebrow text-nes-cyan mb-4">// MEETING POINT</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <p class="font-sans text-nes-white font-semibold text-sm mb-1">Ashinoyashiro Coffee (葦乃社珈琲)</p>
            <p class="font-sans text-gray-400 text-xs leading-relaxed mb-3">
              151 Nagahara-cho, Shimogyo-ku, Kyoto — down the alley on the east side of Yanaginobanba St.,
              just south of Ayanokoji St. Look for the indigo noren (shop curtain) at the end of the alley.
            </p>
            <p class="font-sans text-gray-400 text-xs mb-3">
              About 5 minutes on foot from Nishiki Market, and about 6 minutes from Subway "Shijo" / Hankyu "Karasuma" stations.
              Please arrive 5 minutes before your start time.
            </p>
          </div>
          <div class="space-y-2 font-dot text-base">
            {[
              { k: 'Start times', v: '8:00 / 10:00' },
              { k: 'Duration', v: '70 minutes' },
              { k: 'Dress code', v: 'Casual' },
            ].map(row => (
              <div class="flex justify-between border-b border-gray-800 pb-2">
                <span class="text-gray-400">{row.k}</span>
                <span class="text-nes-white">{row.v}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Booking -->
    <section id="booking" class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">BOOK YOUR SPOT</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <p class="font-sans text-gray-300 text-sm mb-6">Only 4 seats per session. Book early to secure your date.</p>
      <BookingWidget widgetPath="experience-calendar/1242619" />
    </section>

    <!-- Reviews -->
    <ReviewsSection compact />

    <!-- Group CTA -->
    <GroupCTA />

    <!-- FAQ -->
    <section class="mb-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-pixel text-[0.8rem] md:text-[0.9rem] leading-relaxed text-nes-amber">FAQ</h2>
        <div class="flex-1 border-t border-gray-800"></div>
      </div>
      <div class="space-y-3">
        {faqs.map(faq => (
          <details class="border border-gray-800 bg-neutral-900 group">
            <summary class="flex items-center justify-between px-5 py-4 cursor-pointer font-dot text-base md:text-lg leading-snug text-nes-white hover:text-nes-amber transition-colors">
              {faq.q}
              <span class="ml-4 text-gray-400 shrink-0 group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="px-5 pb-4 font-sans text-sm text-gray-400 leading-relaxed border-t border-gray-800 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "Hands-On Coffee Ceremony with a Master near Nishiki Market",
    "description": "Learn Japanese pour-over coffee at a hidden alley cafe a few minutes from Nishiki Market, Kyoto. Grind, bloom, and brew two coffees with a Master, then compare them over Kyoto sweets. 70 minutes, max 4 guests.",
    "url": "https://otatrip.guide/tours/coffee-ceremony",
    "image": "https://otatrip.guide/images/tours/coffee-ceremony/master-lecture.jpg",
    "provider": {
      "@type": "TouristInformationCenter",
      "name": "OTAtrip Guide",
      "url": "https://otatrip.guide"
    },
    "offers": {
      "@type": "Offer",
      "price": "24000",
      "priceCurrency": "JPY",
      "availability": "https://schema.org/InStock"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  })} />
  <StickyBookBar price="¥24,000 / group" slug="coffee-ceremony" />
</BaseLayout>
