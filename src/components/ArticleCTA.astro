---
interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  href?: string;
  primaryLabel?: string;
  secondaryLabel?: string;
  trackPrefix?: string;
}

// Defaults reproduce the original generic CTA, so BlogLayout's no-prop call is unchanged.
const {
  eyebrow = 'Kyoto Local Experience',
  heading = 'Explore Kyoto<br />with a Local Guide',
  body = 'Skip the crowds and see the Kyoto most visitors never find. Small-group tours led by local experts — built around genuine stories, hidden spots, and real connections with the city.',
  href = '/tours',
  primaryLabel = 'See Tour Details',
  secondaryLabel = 'Book Now',
  trackPrefix = 'blog_cta',
} = Astro.props;
---

<div class="article-cta my-12 scanlines">
  <div class="dialogue-box relative z-10 text-center">
    <p class="font-pixel text-[0.6rem] text-nes-cyan mb-4 uppercase leading-relaxed">// {eyebrow}</p>
    <h3 class="font-pixel text-[0.85rem] md:text-[0.95rem] text-nes-white mb-4 leading-loose uppercase" set:html={heading}></h3>
    <p class="font-sans text-sm text-gray-300 leading-relaxed max-w-xl mx-auto mb-4">
      {body}
    </p>
    <div class="flex flex-wrap justify-center gap-6 font-pixel text-[0.55rem] leading-relaxed text-gray-400 mb-6">
      <span class="rpg-prefix">4.9/5 on TripAdvisor</span>
      <span class="rpg-prefix">Small groups</span>
      <span class="rpg-prefix">Local experts</span>
    </div>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={href} class="nes-btn nes-btn-gold" data-track-label={`${trackPrefix}_tour_details`}>
        {primaryLabel}
      </a>
      <a href={href} class="nes-btn nes-btn-outline" data-track-label={`${trackPrefix}_book_now`}>
        {secondaryLabel}
      </a>
    </div>
  </div>
</div>
