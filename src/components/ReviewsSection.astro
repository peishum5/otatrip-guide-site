---
import { TRIPADVISOR_URL } from '../config/site';

interface Props {
  /** Set when the section sits on the dark ParallaxBand backdrop — flips the
   *  TripAdvisor button to the cyan outline style. */
  onDark?: boolean;
  /** Hide the quoted reviews (they are all from the Gion sake walk) and show
   *  only the overall rating + TripAdvisor link. Use on other experiences. */
  compact?: boolean;
}

const { onDark = false, compact = false } = Astro.props;

const reviews = [
  {
    name: 'David N.',
    title: 'A very nice experience',
    date: 'Jul 2026',
    type: 'Couples',
    rating: 5,
    text: "It was a great experience! Our guide Shumpei was very friendly and knowledgable, it adds so much compared to walking around on your own. Thank you! We learned a lot about the area, saw geishas and were invited by a nice family to make a wish and attack it to a bamboo tree.",
  },
  {
    name: 'Frida N.',
    title: 'Friendly, fun and informative',
    date: 'Jul 2026',
    type: 'Couples',
    rating: 5,
    text: "Friendly and informative, simply a great experience for everyone. We had a wonderful time with Shumpei, who was super kind and nice. Highly recommend!",
  },
  {
    name: 'Jacob B.',
    title: 'Fun Experience and Conversations',
    date: 'Jun 2026',
    type: 'Friends',
    rating: 5,
    text: "Fun experience! Had great and interesting conversations with the tour guide. Very insightful and fun! A great way to spend an evening to explore the Gion area.",
  },
  {
    name: 'Solo Traveler',
    title: "Must-do while you're in Kyoto",
    date: 'Feb 2026',
    type: 'Solo',
    rating: 5,
    text: "Wonderful experience with fantastic guides who were very knowledgable, saw shrines when they were virtually empty. Great for solo travelers!",
  },
];
---

<div class={onDark ? '' : 'my-16'}>
  <!-- Header -->
  <div class="text-center mb-10">
    <p class="font-pixel text-[0.6rem] text-nes-amber mb-3 rpg-prefix">PLAYER REVIEWS</p>
    <h2 class="font-pixel text-nes-white leading-relaxed mb-4" style="font-size: clamp(0.7rem, 2vw, 0.95rem);">
      {compact ? 'GUESTS RATE OUR KYOTO EXPERIENCES' : 'WHAT GUESTS SAY'}
    </h2>
    <div class="flex items-center justify-center gap-3">
      <span class="text-nes-amber" style="letter-spacing: 0.1em;">★★★★★</span>
      <span class="font-pixel text-[0.7rem] text-nes-white">4.9 / 5</span>
      <span class="font-sans text-xs text-gray-400">on TripAdvisor</span>
    </div>
  </div>

  <!-- Review cards -->
  {!compact && <div class="grid md:grid-cols-2 gap-5">
    {reviews.map(review => (
      <div class="blog-card p-6 flex flex-col gap-4">
        <!-- Stars + type -->
        <div class="flex items-center justify-between">
          <span class="text-nes-amber" style="letter-spacing: 0.08em; font-size: 0.8rem;">{'★'.repeat(review.rating)}</span>
          <span class="font-pixel text-gray-400" style="font-size: 0.5rem;">{review.type.toUpperCase()}</span>
        </div>

        <!-- Title -->
        <p class="font-dot text-lg text-nes-white leading-snug">{review.title}</p>

        <!-- Body -->
        <p class="font-sans text-sm text-gray-300 leading-relaxed flex-1">"{review.text}"</p>

        <!-- Meta -->
        <div class="flex items-center justify-between border-t border-gray-800/60 pt-3">
          <span class="font-sans text-xs font-semibold text-nes-cyan">{review.name}</span>
          <span class="font-sans text-xs text-gray-400">{review.date}</span>
        </div>
      </div>
    ))}
  </div>}

  <!-- TA link -->
  <div class={compact ? 'text-center' : 'text-center mt-8'}>
    <a
      href={TRIPADVISOR_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={`nes-btn ${onDark ? 'nes-btn-invert' : 'nes-btn-outline'}`}
    >
      SEE ALL REVIEWS ON TRIPADVISOR
    </a>
  </div>
</div>
