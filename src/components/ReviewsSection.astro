---
import { TRIPADVISOR_URL } from '../config/site';

interface Props {
  /** Set when the section sits on the dark ParallaxBand backdrop — flips the
   *  heading and the TripAdvisor button to washi. The cards stay light. */
  onDark?: boolean;
}

const { onDark = false } = Astro.props;

const reviews = [
  {
    name: 'Kyoko O.',
    title: 'Great sunset in Kyoto',
    date: 'Dec 2025',
    type: 'Friends',
    rating: 5,
    text: "One of the things I appreciated the most was, instead of giving long lectures about architecture or history, they led the tour with conversations and answering our questions. We started at 15:30 in December and Kyoto was amazing in its sunset. The sake was really tasty. I think it was really worth the fee, route is nicely organized and fun. Overall we had a great time.",
  },
  {
    name: 'Charlie C.',
    title: 'Unforgettable tour in Gion',
    date: 'Dec 2025',
    type: 'Friends',
    rating: 5,
    text: "This Kyoto tour in Gion was one of the best experiences I've had! We visited the shrines, and the guide shared so much fascinating knowledge about the area. They were incredibly patient, took amazing photos of us, and really made the tour memorable. The sake tasting was fantastic too. Highly recommended!",
  },
  {
    name: 'Solo Traveler',
    title: "Must-do while you're in Kyoto",
    date: 'Feb 2026',
    type: 'Solo',
    rating: 5,
    text: "Wonderful experience with fantastic guides who were very knowledgable, saw shrines when they were virtually empty. Great for solo travelers!",
  },
  {
    name: 'Nathe C.',
    title: 'Local Experience with a Golden Heart',
    date: 'Mar 2026',
    type: 'Solo',
    rating: 5,
    text: "Mune was such an awesome guy! Telling me all about the city's hidden gems. Such a down to earth guy who was happy to answer all the questions I had in regards to Kyoto and Japan as a whole. The sake was perfect to start the tour since it is chilly season. Defs take up a tour with these guys! It's more than worth it. See you again Mune! Such a top bloke!",
  },
];
---

<div class={onDark ? '' : 'my-16'}>
  <!-- Header -->
  <div class="text-center mb-10">
    <p class={`font-display text-sm mb-3 tracking-widest ${onDark ? 'text-kin' : 'text-shu'}`}>Guest Reviews</p>
    <h2 class={`font-display font-bold text-2xl md:text-3xl mb-4 ${onDark ? 'text-washi' : 'text-sumi'}`}>
      What Guests Say
    </h2>
    <div class="flex items-center justify-center gap-3">
      <span class="text-kin" style="letter-spacing: 0.1em;">★★★★★</span>
      <span class={`font-display font-bold ${onDark ? 'text-washi' : 'text-sumi'}`}>4.9 / 5</span>
      <span class={`font-sans text-xs ${onDark ? 'text-washi/70' : 'text-sumi-soft'}`}>on TripAdvisor</span>
    </div>
  </div>

  <!-- Review cards -->
  <div class="grid md:grid-cols-2 gap-5">
    {reviews.map(review => (
      <div class="blog-card p-6 flex flex-col gap-4">
        <!-- Stars + type -->
        <div class="flex items-center justify-between">
          <span class="text-kin" style="letter-spacing: 0.08em; font-size: 0.8rem;">{'★'.repeat(review.rating)}</span>
          <span class="font-display text-xs text-sumi-soft tracking-wide">{review.type}</span>
        </div>

        <!-- Title -->
        <p class="font-display font-semibold text-sumi leading-relaxed">{review.title}</p>

        <!-- Body -->
        <p class="font-sans text-sm text-sumi-soft leading-relaxed flex-1">"{review.text}"</p>

        <!-- Meta -->
        <div class="flex items-center justify-between border-t border-washi-edge pt-3">
          <span class="font-sans text-xs font-semibold text-ai">{review.name}</span>
          <span class="font-sans text-xs text-sumi-soft">{review.date}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- TA link -->
  <div class="text-center mt-8">
    <a
      href={TRIPADVISOR_URL}
      target="_blank"
      rel="noopener noreferrer"
      class={`nes-btn ${onDark ? 'nes-btn-invert' : 'nes-btn-outline'}`}
    >
      See All Reviews on TripAdvisor
    </a>
  </div>
</div>
