---
import { BOKUN_CHANNEL_UUID } from '../config/site';

interface Props {
  /** e.g. "experience/901507" or "experience-calendar/1115233" */
  widgetPath: string;
}
const { widgetPath } = Astro.props;

const widgetSrc = `https://widgets.bokun.io/online-sales/${BOKUN_CHANNEL_UUID}/${widgetPath}`;
---

<div class="booking-widget my-8">
  <div class="bokunWidget" data-src={widgetSrc}></div>
  <noscript>
    <p class="font-pixel text-[1rem] text-nes-red p-4">Please enable javascript in your browser to book</p>
  </noscript>
</div>
