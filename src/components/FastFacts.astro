---
interface FactItem {
  label: string;
  value: string;
  highlight?: boolean;
}

interface Props {
  items: FactItem[];
  title?: string;
}

const { items, title = 'FAST FACTS' } = Astro.props;

const gridCols = items.length === 2 ? 'grid-cols-2'
  : items.length === 4               ? 'grid-cols-2 sm:grid-cols-4'
  : items.length % 3 === 0          ? 'grid-cols-2 md:grid-cols-3'
  :                                    'grid-cols-2 md:grid-cols-3';
---

<div class="my-8">
  <!-- Title -->
  <div class="flex items-center gap-3 mb-4">
    <span class="kicker text-nes-amber text-glow-amber">{title}</span>
    <div class="flex-1 pixel-divider"></div>
  </div>

  <!-- Grid -->
  <div class={`grid ${gridCols} gap-3`}>
    {items.map(item => (
      <div class="fact-card border-t-2 border-nes-amber p-3">
        <div class="font-sans text-xs uppercase tracking-wider text-gray-400 mb-1">
          {item.label}
        </div>
        {item.highlight ? (
          <div class="font-sans text-sm font-semibold text-nes-amber leading-snug">{item.value}</div>
        ) : (
          <div class="font-sans text-sm text-gray-200 leading-snug">{item.value}</div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .fact-card {
    background: #0d0d0d;
    border: 1px solid #1e1e1e;
    overflow: hidden;
  }
</style>
