---
interface FactItem {
  label: string;
  value: string;
  highlight?: boolean;
}

interface Props {
  items: FactItem[];
  title?: string;
}

const { items, title = 'Fast Facts' } = Astro.props;

const gridCols = items.length === 2 ? 'grid-cols-2'
  : items.length === 4               ? 'grid-cols-2 sm:grid-cols-4'
  : items.length % 3 === 0          ? 'grid-cols-2 md:grid-cols-3'
  :                                    'grid-cols-2 md:grid-cols-3';
---

<div class="my-8">
  <!-- Title -->
  <div class="flex items-center gap-3 mb-4">
    <span class="font-display font-semibold text-shu text-sm tracking-widest">{title}</span>
    <div class="flex-1 pixel-divider"></div>
  </div>

  <!-- Grid -->
  <div class={`grid ${gridCols} gap-3`}>
    {items.map(item => (
      <div class="fact-card border-t-2 border-shu p-3">
        <div class="font-display text-sumi-soft mb-1 text-[0.65rem] tracking-widest uppercase">
          {item.label}
        </div>
        {item.highlight ? (
          <div class="font-display font-semibold text-shu leading-snug text-sm">{item.value}</div>
        ) : (
          <div class="font-sans text-sm text-sumi leading-snug">{item.value}</div>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .fact-card {
    background: #faf6ea;
    border: 1px solid var(--color-washi-edge);
    overflow: hidden;
  }
</style>
