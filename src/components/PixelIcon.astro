const { name, size = 24, class: className } = Astro.props;

// Merge horizontal runs of the same color into one rect to keep the markup small.
const rects: { x: number; y: number; w: number; fill: string }[] = [];
ICONS[name].forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    let w = 1;
    while (row[x + w] === ch) w++;
    if (ch !== '.') rects.push({ x, y, w, fill: PALETTE[ch] });
    x += w;
  }
});
---

<svg
  viewBox="0 0 12 12"
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
  class={className}
>
  {rects.map(r => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
</svg>
