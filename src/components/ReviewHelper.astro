---
/**
 * Post-tour review helper, shared by both routes:
 *   /guest/review           → tour = null, the guest picks the tour
 *   /guest/review/<slug>    → tour fixed by the QR code they scanned
 *
 * One screen: impression words, quick ratings and an optional guide name.
 * One button builds a short review and copies it; the review then appears
 * below with "new wording" / "copy again", and a button on to TripAdvisor.
 * The draft is built in the browser from TEMPLATES in config/reviewHelper.ts;
 * the answers are also logged to the owner's spreadsheet (see log()).
 */
import {
  TOURS,
  IMPRESSION_WORDS,
  MAX_WORDS,
  RATING_LEVELS,
  RATING_AXES,
  MAX_GUIDE_NAME_LENGTH,
  REVIEW_LOG_ENDPOINT,
  TEMPLATES,
  tripadvisorUrlFor,
  type ReviewTour,
} from '../config/reviewHelper';

interface Props {
  /** Fixed tour, when the guest arrived from a tour-specific QR code. */
  tour?: ReviewTour | null;
}

const { tour = null } = Astro.props;

const tourData = Object.fromEntries(
  (tour ? [tour] : TOURS).map((t) => [t.slug, { shortName: t.shortName, url: tripadvisorUrlFor(t) }])
);
---

<section class="border-b border-gray-800 bg-nes-black">
  <div class="mx-auto max-w-2xl px-4 py-12 md:py-16">
    <p class="mb-3 font-pixel text-[0.85rem] text-nes-cyan">THANK YOU!</p>
    <h1 class="mb-4 font-sans text-3xl font-bold leading-tight text-nes-white md:text-4xl">
      How was your tour?
    </h1>
    {tour && <p class="mb-3 font-dot text-lg text-nes-amber">{tour.name}</p>}
    <p class="font-sans text-base leading-relaxed text-gray-300">
      Tap a few answers and we will turn them into a short review for TripAdvisor.
      Takes about a minute.
    </p>
  </div>
</section>

<div class="mx-auto max-w-2xl px-4 py-10 md:py-12">
  {!tour && (
    <fieldset class="mb-10">
      <legend class="mb-4 font-sans text-lg font-semibold text-nes-white">
        Which tour did you join?
      </legend>
      <div class="flex flex-col gap-2.5">
        {TOURS.map((option) => (
          <label class="rv-chip">
            <input type="radio" name="tour" value={option.slug} class="sr-only" />
            {option.name}
          </label>
        ))}
      </div>
    </fieldset>
  )}

  <fieldset class="mb-10">
    <legend class="mb-1 font-sans text-lg font-semibold text-nes-white">
      Pick words that fit the tour
    </legend>
    <p class="mb-4 font-sans text-sm text-gray-400">Up to {MAX_WORDS}.</p>
    <div class="flex flex-wrap gap-2.5">
      {IMPRESSION_WORDS.map((word) => (
        <label class="rv-chip">
          <input type="checkbox" name="word" value={word} class="sr-only" />
          {word}
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset class="mb-10">
    <legend class="mb-5 font-sans text-lg font-semibold text-nes-white">Quick ratings</legend>
    <div class="space-y-6">
      {RATING_AXES.map((axis) => (
        <div>
          <p class="mb-2 font-sans text-sm text-gray-300">{axis.label}</p>
          <div class="flex gap-2">
            {RATING_LEVELS.map((level, index) => (
              <label class="rv-chip rv-chip-level">
                <input type="radio" name={`axis_${axis.key}`} value={String(index + 1)} class="sr-only" />
                {level}
              </label>
            ))}
          </div>
        </div>
      ))}
    </div>
  </fieldset>

  <div class="mb-10">
    <label for="guide" class="mb-1 block font-sans text-lg font-semibold text-nes-white">
      Your guide's name
      <span class="ml-1 font-sans text-sm font-normal text-gray-400">(optional)</span>
    </label>
    <p class="mb-4 font-sans text-sm text-gray-400">
      We will mention them in your review. Leave blank to skip.
    </p>
    <input
      type="text"
      id="guide"
      class="rv-input"
      maxlength={MAX_GUIDE_NAME_LENGTH}
      placeholder="e.g. Shumpei"
      autocomplete="off"
      enterkeyhint="done"
    />
  </div>

  <!-- Bot trap. Off-screen, never focusable by a human. -->
  <div class="rv-honeypot" aria-hidden="true">
    <label for="company">Company</label>
    <input type="text" id="company" tabindex="-1" autocomplete="off" />
  </div>

  <p id="form-error" class="mb-4 hidden font-sans text-sm text-nes-amber" role="alert"></p>

  <button type="button" id="make-btn" class="nes-btn nes-btn-gold block w-full whitespace-normal text-center leading-loose">
    SUBMIT &amp; COPY MY REVIEW ▶
  </button>

  <!-- Appears after the tap: the review, proof it was copied, then TripAdvisor. -->
  <section id="result" class="mt-10 hidden scroll-mt-24">
    <div class="mb-4 border-2 border-nes-green bg-[#0f1f0f] px-4 py-3 text-center" aria-live="polite">
      <p id="copy-status" class="font-sans text-base font-bold text-nes-green"></p>
      <p id="copy-hint" class="mt-1 font-sans text-sm text-gray-300"></p>
    </div>

    <p class="mb-2 px-label text-nes-cyan">YOUR REVIEW</p>
    <textarea id="draft" class="rv-input rv-textarea mb-3" aria-label="Your review"></textarea>
    <div class="mb-10 flex gap-3">
      <button type="button" id="reshuffle" class="nes-btn nes-btn-outline flex-1 whitespace-normal text-center">
        NEW WORDING
      </button>
      <button type="button" id="copy-again" class="nes-btn nes-btn-outline flex-1 whitespace-normal text-center">
        COPY AGAIN
      </button>
    </div>

    <div class="dialogue-box">
      <p class="mb-4 font-sans text-base leading-relaxed text-nes-white">
        Last step: open TripAdvisor and <strong>paste</strong> your review.
      </p>
      <a
        id="tripadvisor-link"
        href={tour ? tripadvisorUrlFor(tour) : '#'}
        target="_blank"
        rel="noopener noreferrer"
        class="nes-btn nes-btn-gold block w-full whitespace-normal text-center leading-loose"
        data-track-label="review_helper_tripadvisor"
      >
        GO TO TRIPADVISOR ▶
      </a>
    </div>
  </section>
</div>

<script
  is:inline
  define:vars={{
    tourData,
    fixedTour: tour ? tour.slug : '',
    maxWords: MAX_WORDS,
    maxGuideNameLength: MAX_GUIDE_NAME_LENGTH,
    axisKeys: RATING_AXES.map((axis) => axis.key),
    templates: TEMPLATES,
    logEndpoint: REVIEW_LOG_ENDPOINT,
  }}
>
  (function () {
    var guideInput = document.getElementById('guide');
    var makeBtn = document.getElementById('make-btn');
    var tripadvisorLink = document.getElementById('tripadvisor-link');
    var draft = document.getElementById('draft');
    var result = document.getElementById('result');
    var copyStatus = document.getElementById('copy-status');
    var copyHint = document.getElementById('copy-hint');
    var formError = document.getElementById('form-error');

    // ?g=Shumpei fills the name in, so a guide can hand over a ready-made link.
    var requestedGuide = new URLSearchParams(window.location.search).get('g');
    if (requestedGuide) guideInput.value = requestedGuide.slice(0, maxGuideNameLength);

    function checked(name) {
      var field = document.querySelector('input[name="' + name + '"]:checked');
      return field ? field.value : '';
    }

    function tourSlug() {
      return fixedTour || checked('tour');
    }

    // On the all-tours page, point the TripAdvisor button at the chosen tour.
    document.querySelectorAll('input[name="tour"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        tripadvisorLink.href = tourData[radio.value].url;
        formError.classList.add('hidden');
      });
    });

    // Cap word picks: once the limit is hit, the rest are disabled.
    var wordBoxes = Array.prototype.slice.call(document.querySelectorAll('input[name="word"]'));
    wordBoxes.forEach(function (box) {
      box.addEventListener('change', function () {
        var count = wordBoxes.filter(function (b) { return b.checked; }).length;
        wordBoxes.forEach(function (b) {
          b.disabled = !b.checked && count >= maxWords;
        });
      });
    });

    function pick(list) {
      return list[Math.floor(Math.random() * list.length)];
    }

    function capitalize(text) {
      return text.charAt(0).toUpperCase() + text.slice(1);
    }

    function joinWords(words) {
      var lower = words.map(function (w) { return w.toLowerCase(); });
      if (lower.length < 2) return lower.join('');
      return lower.slice(0, -1).join(', ') + ' and ' + lower[lower.length - 1];
    }

    function buildDraft() {
      var guide = guideInput.value.trim();
      var words = wordBoxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; });
      var tour = tourData[tourSlug()];

      function fill(text) {
        return text
          .replace(/\{G\}/g, guide || 'Our guide')
          .replace(/\{g\}/g, guide || 'our guide')
          .replace(/\{t\}/g, tour.shortName)
          .replace(/\{W\}/g, capitalize(joinWords(words)))
          .replace(/\{w\}/g, joinWords(words));
      }

      var sentences = [fill(pick(words.length ? templates.openerWithWords : templates.openerNoWords))];
      axisKeys.forEach(function (key) {
        var level = checked('axis_' + key);
        if (level) sentences.push(fill(pick(templates[key][level])));
      });
      sentences.push(pick(templates.closer));
      return sentences.join(' ');
    }

    function fitDraft() {
      // Grow to fit, so the whole draft is visible without scrolling the box.
      draft.style.height = 'auto';
      draft.style.height = draft.scrollHeight + 4 + 'px';
    }

    function fallbackCopy() {
      draft.select();
      draft.setSelectionRange(0, draft.value.length);
      try {
        return document.execCommand('copy');
      } catch (e) {
        return false;
      }
    }

    function copyDraft() {
      var done = function () {
        copyStatus.textContent = '\u2714 Review copied!';
        copyHint.textContent = 'It is ready to paste on TripAdvisor.';
      };
      var failed = function () {
        copyStatus.textContent = 'Could not copy automatically.';
        copyHint.textContent = 'Please press and hold the text below to copy it.';
      };
      // Clear first, so a repeat copy visibly blinks and the guest sees it happen.
      copyStatus.textContent = '';
      copyHint.textContent = '';
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(draft.value).then(done, function () {
          fallbackCopy() ? done() : failed();
        });
      } else {
        fallbackCopy() ? done() : failed();
      }
    }

    // One id per page view, so pressing submit again updates the same
    // spreadsheet row instead of adding a new one.
    var visitId = Math.random().toString(36).slice(2, 12) + Date.now().toString(36);

    /**
     * Fire-and-forget log to the owner's spreadsheet. Apps Script cannot
     * answer a CORS preflight, so this is a no-cors text/plain send: we never
     * see the reply, and a failure must never get in the guest's way.
     */
    function log(payload) {
      if (!logEndpoint) return;
      payload.id = visitId;
      try {
        fetch(logEndpoint, {
          method: 'POST',
          mode: 'no-cors',
          keepalive: true,
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        }).catch(function () {});
      } catch (e) {}
    }

    function logAnswers() {
      var ratings = {};
      axisKeys.forEach(function (key) {
        ratings[key] = checked('axis_' + key);
      });
      log({
        type: 'submit',
        tour: tourSlug(),
        words: wordBoxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; }),
        ratings: ratings,
        guide: guideInput.value.trim().slice(0, maxGuideNameLength),
        draft: draft.value,
        company: document.getElementById('company').value,
      });
    }

    function makeReview() {
      // The draft is shown before copying: the fallback copy needs visible text.
      draft.value = buildDraft();
      fitDraft();
      copyDraft();
    }

    makeBtn.addEventListener('click', function () {
      if (!tourSlug()) {
        formError.textContent = 'Please choose which tour you joined.';
        formError.classList.remove('hidden');
        formError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      formError.classList.add('hidden');
      result.classList.remove('hidden');
      makeReview();
      logAnswers();
      makeBtn.textContent = 'UPDATE MY REVIEW \u25B6';
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (window.track) window.track('review_helper_submit', { tour: tourSlug() });
    });

    document.getElementById('reshuffle').addEventListener('click', makeReview);
    document.getElementById('copy-again').addEventListener('click', copyDraft);
    tripadvisorLink.addEventListener('click', function () {
      // Send the final text too: the guest may have reworded or edited it.
      log({ type: 'tripadvisor', draft: draft.value });
    });
    draft.addEventListener('input', fitDraft);
  })();
</script>
