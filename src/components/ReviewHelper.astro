---
/**
 * Post-tour review helper, shared by both routes:
 *   /guest/review           → tour = null, the guest picks the tour
 *   /guest/review/<slug>    → tour fixed by the QR code they scanned
 *
 * Three steps on one page: impressions → guide name → draft review with a
 * copy button and the TripAdvisor link. Nothing is sent anywhere; the draft
 * is built in the browser from TEMPLATES in config/reviewHelper.ts.
 */
import {
  TOURS,
  IMPRESSION_WORDS,
  MAX_WORDS,
  RATING_LEVELS,
  RATING_AXES,
  MAX_GUIDE_NAME_LENGTH,
  TEMPLATES,
  tripadvisorUrlFor,
  type ReviewTour,
} from '../config/reviewHelper';

interface Props {
  /** Fixed tour, when the guest arrived from a tour-specific QR code. */
  tour?: ReviewTour | null;
}

const { tour = null } = Astro.props;

const tourData = Object.fromEntries(
  (tour ? [tour] : TOURS).map((t) => [t.slug, { shortName: t.shortName, url: tripadvisorUrlFor(t) }])
);
---

<section class="border-b border-gray-800 bg-nes-black">
  <div class="mx-auto max-w-2xl px-4 py-12 md:py-16">
    <p class="mb-3 font-pixel text-[0.85rem] text-nes-cyan">THANK YOU!</p>
    <h1 class="mb-4 font-sans text-3xl font-bold leading-tight text-nes-white md:text-4xl">
      How was your tour?
    </h1>
    {tour && <p class="mb-3 font-dot text-lg text-nes-amber">{tour.name}</p>}
    <p class="font-sans text-base leading-relaxed text-gray-300">
      Tap a few answers and we will turn them into a short review you can post on
      TripAdvisor. Takes about a minute.
    </p>
  </div>
</section>

<div class="mx-auto max-w-2xl px-4 py-10 md:py-12">
  <!-- ========================= STEP 1: IMPRESSIONS ========================= -->
  <div id="step-1">
    <p class="mb-6 px-label text-nes-cyan">STEP 1 / 2</p>

    {!tour && (
      <fieldset class="mb-10">
        <legend class="mb-4 font-sans text-lg font-semibold text-nes-white">
          Which tour did you join?
        </legend>
        <div class="flex flex-col gap-2.5">
          {TOURS.map((option) => (
            <label class="rv-chip">
              <input type="radio" name="tour" value={option.slug} class="sr-only" />
              {option.name}
            </label>
          ))}
        </div>
      </fieldset>
    )}

    <fieldset class="mb-10">
      <legend class="mb-1 font-sans text-lg font-semibold text-nes-white">
        Pick words that fit the tour
      </legend>
      <p class="mb-4 font-sans text-sm text-gray-400">Up to {MAX_WORDS}.</p>
      <div class="flex flex-wrap gap-2.5" id="word-chips">
        {IMPRESSION_WORDS.map((word) => (
          <label class="rv-chip">
            <input type="checkbox" name="word" value={word} class="sr-only" />
            {word}
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="mb-10">
      <legend class="mb-5 font-sans text-lg font-semibold text-nes-white">Quick ratings</legend>
      <div class="space-y-6">
        {RATING_AXES.map((axis) => (
          <div>
            <p class="mb-2 font-sans text-sm text-gray-300">{axis.label}</p>
            <div class="flex gap-2">
              {RATING_LEVELS.map((level, index) => (
                <label class="rv-chip rv-chip-level">
                  <input type="radio" name={`axis_${axis.key}`} value={String(index + 1)} class="sr-only" />
                  {level}
                </label>
              ))}
            </div>
          </div>
        ))}
      </div>
    </fieldset>

    <p id="step-1-error" class="mb-4 hidden font-sans text-sm text-nes-amber" role="alert"></p>

    <button type="button" id="to-step-2" class="nes-btn nes-btn-gold w-full text-center">
      NEXT ▶
    </button>
  </div>

  <!-- ========================= STEP 2: GUIDE NAME ========================= -->
  <div id="step-2" class="hidden">
    <p class="mb-6 px-label text-nes-cyan">STEP 2 / 2</p>

    <label for="guide" class="mb-2 block font-sans text-lg font-semibold text-nes-white">
      What was your guide's name?
    </label>
    <p class="mb-4 font-sans text-sm text-gray-400">First name is plenty.</p>
    <input
      type="text"
      id="guide"
      class="rv-input mb-8"
      maxlength={MAX_GUIDE_NAME_LENGTH}
      placeholder="e.g. Shumpei"
      autocomplete="off"
    />

    <div class="flex flex-col-reverse gap-3 sm:flex-row">
      <button type="button" id="back-to-1" class="nes-btn nes-btn-outline text-center">BACK</button>
      <button type="button" id="to-step-3" class="nes-btn nes-btn-gold flex-1 text-center">
        MAKE MY REVIEW ▶
      </button>
    </div>
  </div>

  <!-- ========================= STEP 3: DRAFT + LINK ========================= -->
  <div id="step-3" class="hidden">
    <p class="mb-3 px-label text-nes-cyan">YOUR REVIEW</p>
    <p class="mb-4 font-sans text-sm leading-relaxed text-gray-300">
      Here is a draft. Feel free to change anything or add a line in your own words.
    </p>

    <textarea id="draft" class="rv-input rv-textarea mb-2" aria-label="Your review"></textarea>
    <button type="button" id="reshuffle" class="mb-8 font-sans text-sm text-nes-cyan underline">
      Try different wording
    </button>

    <div class="dialogue-box">
      <button type="button" id="copy-btn" class="nes-btn nes-btn-gold w-full text-center">
        COPY REVIEW
      </button>
      <p id="copy-status" class="mt-3 min-h-[1.5rem] text-center font-sans text-sm text-nes-green" aria-live="polite"></p>

      <p class="mb-3 mt-4 font-sans text-sm leading-relaxed text-gray-300">
        Then open TripAdvisor and paste it in:
      </p>
      <a
        id="tripadvisor-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="nes-btn nes-btn-invert block w-full text-center"
        data-track-label="review_helper_tripadvisor"
      >
        OPEN TRIPADVISOR ▶
      </a>
    </div>

    <button type="button" id="back-to-start" class="mt-8 font-sans text-sm text-gray-400 underline">
      Change my answers
    </button>
  </div>
</div>

<script
  is:inline
  define:vars={{
    tourData,
    fixedTour: tour ? tour.slug : '',
    maxWords: MAX_WORDS,
    maxGuideNameLength: MAX_GUIDE_NAME_LENGTH,
    axisKeys: RATING_AXES.map((axis) => axis.key),
    templates: TEMPLATES,
  }}
>
  (function () {
    var steps = [1, 2, 3].map(function (n) {
      return document.getElementById('step-' + n);
    });
    var guideInput = document.getElementById('guide');
    var draft = document.getElementById('draft');
    var copyStatus = document.getElementById('copy-status');
    var step1Error = document.getElementById('step-1-error');

    // ?g=Shumpei fills the name in, so a guide can hand over a ready-made link.
    var requestedGuide = new URLSearchParams(window.location.search).get('g');
    if (requestedGuide) guideInput.value = requestedGuide.slice(0, maxGuideNameLength);

    function show(n) {
      steps.forEach(function (el, i) {
        el.classList.toggle('hidden', i !== n - 1);
      });
      // 'instant': the site sets smooth scrolling globally, which gets
      // cancelled when the page height changes underneath it.
      window.scrollTo({ top: 0, behavior: 'instant' });
    }

    function checked(name) {
      var field = document.querySelector('input[name="' + name + '"]:checked');
      return field ? field.value : '';
    }

    function tourSlug() {
      return fixedTour || checked('tour');
    }

    // Cap word picks: once the limit is hit, the rest are disabled.
    var wordBoxes = Array.prototype.slice.call(document.querySelectorAll('input[name="word"]'));
    wordBoxes.forEach(function (box) {
      box.addEventListener('change', function () {
        var count = wordBoxes.filter(function (b) { return b.checked; }).length;
        wordBoxes.forEach(function (b) {
          b.disabled = !b.checked && count >= maxWords;
        });
      });
    });

    function pick(list) {
      return list[Math.floor(Math.random() * list.length)];
    }

    function joinWords(words) {
      var lower = words.map(function (w) { return w.toLowerCase(); });
      if (lower.length < 2) return lower.join('');
      return lower.slice(0, -1).join(', ') + ' and ' + lower[lower.length - 1];
    }

    function capitalize(text) {
      return text.charAt(0).toUpperCase() + text.slice(1);
    }

    function buildDraft() {
      var guide = guideInput.value.trim();
      var words = wordBoxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; });
      var tour = tourData[tourSlug()];

      function fill(text) {
        return text
          .replace(/\{G\}/g, guide || 'Our guide')
          .replace(/\{g\}/g, guide || 'our guide')
          .replace(/\{t\}/g, tour.shortName)
          .replace(/\{W\}/g, capitalize(joinWords(words)))
          .replace(/\{w\}/g, joinWords(words));
      }

      var sentences = [fill(pick(words.length ? templates.openerWithWords : templates.openerNoWords))];
      axisKeys.forEach(function (key) {
        var level = checked('axis_' + key);
        if (level) sentences.push(fill(pick(templates[key][level])));
      });
      sentences.push(pick(templates.closer));
      return sentences.join(' ');
    }

    function renderDraft() {
      draft.value = buildDraft();
      // Grow to fit, so the whole draft is visible without scrolling the box.
      draft.style.height = 'auto';
      draft.style.height = draft.scrollHeight + 4 + 'px';
      copyStatus.textContent = '';
    }

    document.getElementById('to-step-2').addEventListener('click', function () {
      if (!tourSlug()) {
        step1Error.textContent = 'Please choose which tour you joined.';
        step1Error.classList.remove('hidden');
        return;
      }
      step1Error.classList.add('hidden');
      show(2);
      guideInput.focus();
    });

    document.getElementById('to-step-3').addEventListener('click', function () {
      document.getElementById('tripadvisor-link').href = tourData[tourSlug()].url;
      // Show first: a hidden textarea has no height to measure.
      show(3);
      renderDraft();
      if (window.track) window.track('review_helper_draft', { tour: tourSlug() });
    });

    guideInput.addEventListener('keydown', function (event) {
      if (event.key === 'Enter') document.getElementById('to-step-3').click();
    });

    document.getElementById('back-to-1').addEventListener('click', function () { show(1); });
    document.getElementById('back-to-start').addEventListener('click', function () { show(1); });
    document.getElementById('reshuffle').addEventListener('click', renderDraft);

    function fallbackCopy() {
      draft.select();
      draft.setSelectionRange(0, draft.value.length);
      return document.execCommand('copy');
    }

    document.getElementById('copy-btn').addEventListener('click', function () {
      var done = function () {
        copyStatus.textContent = 'Copied! Now paste it on TripAdvisor.';
        if (window.track) window.track('review_helper_copy', { tour: tourSlug() });
      };
      var failed = function () {
        copyStatus.textContent = 'Could not copy. Please select the text and copy it.';
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(draft.value).then(done, function () {
          fallbackCopy() ? done() : failed();
        });
      } else {
        fallbackCopy() ? done() : failed();
      }
    });
  })();
</script>
