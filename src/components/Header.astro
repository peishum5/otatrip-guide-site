---
const navLinks = [
  { href: '/tours', label: 'TOURS' },
  { href: '/blog', label: 'GUIDES' },
  { href: '/groups', label: 'GROUPS' },
  { href: '/guide', label: 'OUR GUIDE' },
  { href: '/contact', label: 'CONTACT' },
];
const currentPath = Astro.url.pathname;
---

<header class="bg-nes-black border-b border-gray-800 sticky top-0 z-50">
  <!-- Top amber accent line -->
  <div class="h-[2px] w-full bg-gradient-to-r from-transparent via-nes-amber to-transparent opacity-70"></div>

  <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <div class="flex flex-col gap-1">
        <span class="font-pixel leading-tight text-nes-amber" style="font-size: 0.9rem;">OTAtrip GUIDE</span>
        <span class="font-sans leading-tight text-gray-400 uppercase" style="font-size: 0.65rem; letter-spacing: 0.18em;">Kyoto Local Experts</span>
      </div>
    </a>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn"
      class="md:hidden font-sans uppercase tracking-widest text-xs text-nes-amber border border-gray-700 px-3 py-2 hover:border-nes-amber hover:bg-nes-amber/10 transition-all"
      aria-label="Toggle menu">
      Menu
    </button>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`relative font-sans text-sm uppercase tracking-wider px-4 py-2 transition-colors hover:text-nes-amber ${
            currentPath.startsWith(link.href) && link.href !== '/'
              ? 'text-nes-amber'
              : 'text-gray-400'
          }`}
        >
          {link.label}
          {currentPath.startsWith(link.href) && link.href !== '/' && (
            <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 bg-nes-amber shadow-[0_0_6px_rgba(255,176,0,0.8)]"></span>
          )}
        </a>
      ))}
      <a href="/tours" class="ml-3 font-pixel bg-nes-amber text-nes-black border border-nes-amber hover:bg-transparent hover:text-nes-amber transition-all"
        style="font-size: 0.55rem; padding: 0.6rem 1rem; letter-spacing: 0.06em; box-shadow: 3px 3px 0 rgba(255,176,0,0.3);">
        BOOK TOUR
      </a>
    </nav>
  </div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="hidden md:hidden bg-nes-black border-t border-gray-800 px-4 pb-4">
    {navLinks.map(link => (
      <a
        href={link.href}
        class={`flex items-center justify-between py-3 font-sans text-sm uppercase tracking-wider border-b border-gray-800 transition-colors hover:text-nes-amber ${
          currentPath.startsWith(link.href) && link.href !== '/' ? 'text-nes-amber' : 'text-gray-300'
        }`}
      >
        {link.label}
        <span class="text-gray-600">&rsaquo;</span>
      </a>
    ))}
    <a href="/tours"
      class="block mt-4 font-pixel text-center bg-nes-amber text-nes-black py-3 hover:bg-transparent hover:text-nes-amber border border-nes-amber transition-all"
      style="font-size: 0.55rem;">
      BOOK A TOUR
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
