---
interface Props {
  type?: 'tip' | 'warning' | 'local' | 'budget';
  title?: string;
}

const { type = 'tip', title } = Astro.props;

const configs = {
  tip:     { label: title ?? 'Tip',        kanji: '豆', color: 'text-ai',    stripe: '#165e83' },
  warning: { label: title ?? 'Caution',    kanji: '注', color: 'text-shu',   stripe: '#9e1f23' },
  local:   { label: title ?? 'Local Tip',  kanji: '奨', color: 'text-shu',   stripe: '#c3272b' },
  budget:  { label: title ?? 'Budget Tip', kanji: '得', color: 'text-matsu', stripe: '#4d6b44' },
};
const config = configs[type as keyof typeof configs] ?? configs.tip;
---

<div class="tipbox my-6 flex overflow-hidden" style={`border: 1px solid ${config.stripe}55; background: #faf6ea;`}>
  <!-- Left stripe -->
  <div class="shrink-0 w-1" style={`background: ${config.stripe};`}></div>

  <div class="flex-1 p-4">
    <!-- Label -->
    <div class={`font-display font-semibold mb-2 flex items-center gap-2 text-xs tracking-widest ${config.color}`}>
      <span class="tip-kanji" style={`background: ${config.stripe};`}>{config.kanji}</span>
      <span>{config.label}</span>
    </div>
    <!-- Body -->
    <div class="font-sans text-sm text-sumi leading-relaxed tipbox-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .tip-kanji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.7em;
    height: 1.7em;
    color: #f5efdf;
    font-family: var(--font-brush);
    font-size: 1.05em;
    line-height: 1;
    border-radius: 3px;
  }
  .tipbox-body :global(p) {
    margin: 0;
  }
  .tipbox-body :global(p + p) {
    margin-top: 0.5rem;
  }
  .tipbox-body :global(ul) {
    margin: 0.25rem 0 0;
    padding-left: 1.25rem;
  }
  .tipbox-body :global(li) {
    margin: 0.2rem 0;
    line-height: 1.6;
  }
</style>
