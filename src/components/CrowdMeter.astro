---
interface Props {
  label: string;
  level: 1 | 2 | 3 | 4 | 5;
  note?: string;
}

const { label, level, note } = Astro.props;

const pct = level * 20;
const color = level <= 2 ? '#4d6b44' : level === 3 ? '#a07830' : '#c3272b';
const text  = ['Quiet', 'Low', 'Moderate', 'Busy', 'Avoid'][level - 1];
---

<div class="crowd-meter my-3">
  <div class="flex items-center justify-between mb-1">
    <span class="font-sans text-xs text-sumi-soft">{label}</span>
    <span class="font-display text-xs font-semibold tracking-wide" style={`color: ${color};`}>{text}</span>
  </div>
  <div class="stat-bar-track">
    <div class="stat-bar-fill" style={`width: ${pct}%; background: ${color};`}></div>
  </div>
  {note && <p class="font-sans text-xs text-sumi-soft mt-1">{note}</p>}
</div>
