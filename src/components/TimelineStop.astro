---
interface Props {
  time: string;
  location: string;
  duration?: string;
  transport?: string;
  cost?: string;
}

const { time, location, duration, transport, cost } = Astro.props;
---

<div class="timeline-stop relative mb-8">
  <!-- Node dot -->
  <div class="timeline-node absolute" style="left: -2.7rem; top: 0.25rem; width: 14px; height: 14px; background: var(--color-shu); border: 2px solid var(--color-sumi); border-radius: 50%;"></div>

  <!-- Time badge -->
  <div class="inline-block font-display font-semibold text-washi bg-ai-deep mb-2 px-2.5 py-1 text-xs tracking-wide">
    {time}
  </div>

  <!-- Location -->
  <div class="font-display font-semibold text-sumi mb-2 leading-relaxed">{location}</div>

  <!-- Meta -->
  {(duration || transport || cost) && (
    <div class="flex flex-wrap gap-x-4 gap-y-1 mb-3">
      {duration  && <span class="font-sans text-xs text-sumi-soft rpg-prefix">{duration}</span>}
      {transport && <span class="font-sans text-xs text-sumi-soft rpg-prefix">{transport}</span>}
      {cost      && <span class="font-sans text-xs font-medium text-matsu rpg-prefix">{cost}</span>}
    </div>
  )}

  <!-- Body content -->
  <div class="font-sans text-sm text-sumi-soft leading-relaxed timeline-body">
    <slot />
  </div>
</div>

<style>
  .timeline-body :global(p) {
    margin: 0 0 0.5rem;
  }
  .timeline-body :global(ul) {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
  }
  .timeline-body :global(li) {
    margin: 0.2rem 0;
    line-height: 1.6;
  }
</style>
