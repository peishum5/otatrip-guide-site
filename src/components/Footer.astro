---
import { CONTACT_EMAIL } from '../config/site';
---

<footer class="bg-nes-black border-t border-gray-800 mt-16">
  <!-- Top decoration -->
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-nes-amber to-transparent opacity-40"></div>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <h3 class="font-pixel text-nes-amber pixel-flicker mb-3" style="font-size: 0.85rem;">OTAtrip GUIDE</h3>
        <p class="font-pixel text-gray-700 mb-4" style="font-size: 0.45rem; letter-spacing: 0.08em;">KYOTO LOCAL EXPERTS</p>
        <p class="font-sans text-sm text-gray-500 leading-relaxed max-w-xs">
          Local experts guiding you through Kyoto's best sake bars, hidden alleys, and cultural gems.
          Based in Gion since 2024.
        </p>
        <div class="flex items-center gap-4 mt-5">
          <a href="https://x.com/otatrip_guide" target="_blank" rel="noopener"
            class="font-pixel text-gray-600 hover:text-nes-amber transition-colors" style="font-size: 0.45rem;">
            X / TWITTER
          </a>
          <span class="text-gray-800">·</span>
          <a href="https://instagram.com/otatrip_guide" target="_blank" rel="noopener"
            class="font-pixel text-gray-600 hover:text-nes-amber transition-colors" style="font-size: 0.45rem;">
            INSTAGRAM
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-pixel text-nes-cyan mb-5" style="font-size: 0.5rem; letter-spacing: 0.1em;">// EXPLORE</h4>
        <ul class="space-y-3">
          {[
            { href: '/tours', label: 'All Tours' },
            { href: '/blog', label: 'Travel Guides' },
            { href: '/guide', label: 'Our Guide' },
            { href: '/groups', label: 'Groups & Agencies' },
            { href: '/game', label: 'Gion Night Quest (Game)' },
            { href: '/contact', label: 'Contact Us' },
          ].map(link => (
            <li>
              <a href={link.href} class="font-pixel text-gray-600 hover:text-nes-amber transition-colors flex items-center gap-2" style="font-size: 0.45rem;">
                <span class="text-nes-amber opacity-40">&rsaquo;</span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-pixel text-nes-cyan mb-5" style="font-size: 0.5rem; letter-spacing: 0.1em;">// CONTACT</h4>
        <ul class="space-y-3">
          <li class="font-pixel text-gray-700 flex items-center gap-2" style="font-size: 0.45rem;">
            <span class="text-nes-amber opacity-40">&rsaquo;</span> Based in Kyoto, Japan
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`}
              class="font-pixel text-gray-600 hover:text-nes-amber transition-colors flex items-center gap-2" style="font-size: 0.45rem;">
              <span class="text-nes-amber opacity-40">&rsaquo;</span> {CONTACT_EMAIL}
            </a>
          </li>
          <li class="pt-2">
            <a href="/groups" class="font-pixel text-nes-amber hover:text-nes-white transition-colors flex items-center gap-2" style="font-size: 0.45rem;">
              <span>&rsaquo;</span> Group inquiries &amp; bookings
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pixel-divider mb-6 opacity-20"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="font-pixel text-gray-700" style="font-size: 0.4rem;">&copy; {new Date().getFullYear()} OTAtrip Guide. All rights reserved.</p>
      <div class="flex items-center gap-4 font-pixel text-gray-700" style="font-size: 0.4rem;">
        <a href="/tours" class="hover:text-nes-amber transition-colors">TOURS</a>
        <span class="text-gray-800">·</span>
        <a href="/blog" class="hover:text-nes-amber transition-colors">GUIDES</a>
        <span class="text-gray-800">·</span>
        <a href="/guide" class="hover:text-nes-amber transition-colors">GUIDE</a>
        <span class="text-gray-800">·</span>
        <a href="/contact" class="hover:text-nes-amber transition-colors">CONTACT</a>
      </div>
    </div>
  </div>
</footer>
