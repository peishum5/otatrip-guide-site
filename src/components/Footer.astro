---
import { CONTACT_EMAIL } from '../config/site';
---

<footer class="bg-washi-deep border-t border-washi-edge mt-16 asanoha-bg">
  <!-- Top decoration -->
  <div class="h-[2px] w-full bg-gradient-to-r from-transparent via-shu to-transparent opacity-50"></div>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2.5 mb-3">
          <span class="hanko text-base" aria-hidden="true">旅</span>
          <h3 class="font-display font-bold text-sumi text-lg">OTAtrip Guide</h3>
        </div>
        <p class="font-sans text-sumi-soft mb-4 text-[0.7rem] tracking-[0.18em] uppercase">Kyoto Local Experts</p>
        <p class="font-sans text-sm text-sumi-soft leading-relaxed max-w-xs">
          Local experts guiding you through Kyoto's best sake bars, hidden alleys, and cultural gems.
          Based in Gion since 2024.
        </p>
        <div class="flex items-center gap-4 mt-5">
          <a href="https://x.com/otatrip_guide" target="_blank" rel="noopener"
            class="font-display text-xs text-sumi-soft hover:text-shu transition-colors tracking-wide">
            X / Twitter
          </a>
          <span class="text-washi-edge">·</span>
          <a href="https://instagram.com/otatrip_guide" target="_blank" rel="noopener"
            class="font-display text-xs text-sumi-soft hover:text-shu transition-colors tracking-wide">
            Instagram
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="font-display font-semibold text-ai mb-5 text-sm tracking-widest">Explore</h4>
        <ul class="space-y-3">
          {[
            { href: '/tours', label: 'All Tours' },
            { href: '/blog', label: 'Travel Guides' },
            { href: '/guide', label: 'Our Guide' },
            { href: '/book', label: "Our Book: Don't Be That Tourist" },
            { href: '/groups', label: 'Groups & Agencies' },
            { href: '/game', label: 'Gion Night Quest (Game)' },
            { href: '/contact', label: 'Contact Us' },
          ].map(link => (
            <li>
              <a href={link.href} class="font-sans text-xs text-sumi-soft hover:text-shu transition-colors flex items-center gap-2">
                <span class="text-shu opacity-50">&rsaquo;</span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display font-semibold text-ai mb-5 text-sm tracking-widest">Contact</h4>
        <ul class="space-y-3">
          <li class="font-sans text-xs text-sumi-soft flex items-center gap-2">
            <span class="text-shu opacity-50">&rsaquo;</span> Based in Kyoto, Japan
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`}
              class="font-sans text-xs text-sumi-soft hover:text-shu transition-colors flex items-center gap-2">
              <span class="text-shu opacity-50">&rsaquo;</span> {CONTACT_EMAIL}
            </a>
          </li>
          <li class="pt-2">
            <a href="/groups" class="font-sans text-xs font-medium text-shu hover:text-shu-dark transition-colors flex items-center gap-2">
              <span>&rsaquo;</span> Group inquiries &amp; bookings
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pixel-divider mb-6 opacity-40"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="font-sans text-[0.7rem] text-sumi-soft">&copy; {new Date().getFullYear()} OTAtrip Guide. All rights reserved.</p>
      <div class="flex items-center gap-4 font-display text-[0.7rem] text-sumi-soft tracking-wide">
        <a href="/tours" class="hover:text-shu transition-colors">Tours</a>
        <span class="text-washi-edge">·</span>
        <a href="/blog" class="hover:text-shu transition-colors">Guides</a>
        <span class="text-washi-edge">·</span>
        <a href="/guide" class="hover:text-shu transition-colors">Guide</a>
        <span class="text-washi-edge">·</span>
        <a href="/contact" class="hover:text-shu transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
