---
---

<footer class="bg-nes-black border-t border-gray-800 mt-16">
  <!-- Top decoration -->
  <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-nes-amber to-transparent opacity-40"></div>

  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <h3 class="font-pixel text-nes-amber mb-3" style="font-size: 0.85rem;">OTAtrip GUIDE</h3>
        <p class="font-sans text-gray-400 uppercase mb-4" style="font-size: 0.7rem; letter-spacing: 0.18em;">Kyoto Local Experts</p>
        <p class="font-sans text-sm text-gray-400 leading-relaxed max-w-xs">
          Local experts guiding you through Kyoto's best sake bars, hidden alleys, and cultural gems.
          Based in Gion since 2024.
        </p>
        <div class="flex items-center gap-4 mt-5">
          <a href="https://x.com/otatrip_guide" target="_blank" rel="noopener"
            class="font-sans text-xs uppercase tracking-wider text-gray-400 hover:text-nes-amber transition-colors">
            X / Twitter
          </a>
          <span class="text-gray-600">·</span>
          <a href="https://instagram.com/otatrip_guide" target="_blank" rel="noopener"
            class="font-sans text-xs uppercase tracking-wider text-gray-400 hover:text-nes-amber transition-colors">
            Instagram
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h4 class="kicker text-nes-cyan mb-5">// EXPLORE</h4>
        <ul class="space-y-3">
          {[
            { href: '/tours', label: 'All Tours' },
            { href: '/blog', label: 'Travel Guides' },
            { href: '/guide', label: 'Our Guide' },
            { href: '/groups', label: 'Groups & Agencies' },
            { href: '/contact', label: 'Contact Us' },
          ].map(link => (
            <li>
              <a href={link.href} class="font-sans text-sm text-gray-400 hover:text-nes-amber transition-colors flex items-center gap-2">
                <span class="text-nes-amber opacity-50">&rsaquo;</span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="kicker text-nes-cyan mb-5">// CONTACT</h4>
        <ul class="space-y-3">
          <li class="font-sans text-sm text-gray-400 flex items-center gap-2">
            <span class="text-nes-amber opacity-50">&rsaquo;</span> Based in Kyoto, Japan
          </li>
          <li>
            <a href="mailto:kyoto.otatrip.guide@gmail.com"
              class="font-sans text-sm text-gray-400 hover:text-nes-amber transition-colors flex items-center gap-2 break-all">
              <span class="text-nes-amber opacity-50">&rsaquo;</span> kyoto.otatrip.guide@gmail.com
            </a>
          </li>
          <li class="pt-2">
            <a href="/groups" class="font-sans text-sm text-nes-amber hover:text-nes-white transition-colors flex items-center gap-2">
              <span>&rsaquo;</span> Group inquiries &amp; bookings
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="pixel-divider mb-6 opacity-20"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="font-sans text-xs text-gray-500">&copy; {new Date().getFullYear()} OTAtrip Guide. All rights reserved.</p>
      <div class="flex items-center gap-4 font-sans text-xs uppercase tracking-wider text-gray-400">
        <a href="/tours" class="hover:text-nes-amber transition-colors">Tours</a>
        <span class="text-gray-600">·</span>
        <a href="/blog" class="hover:text-nes-amber transition-colors">Guides</a>
        <span class="text-gray-600">·</span>
        <a href="/guide" class="hover:text-nes-amber transition-colors">Guide</a>
        <span class="text-gray-600">·</span>
        <a href="/contact" class="hover:text-nes-amber transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
